---
import type { CaseStudy, Project } from "../data/types";
import Icon from "./Icon.astro";
import ProjectDocumentation from "./ProjectDocumentation.astro";
import { pathTo } from "../lib/urls";
interface Props { study: CaseStudy; project: Project }
const { study, project } = Astro.props;
const sections = [
  ["problem", "Problem & constraints"],
  ["architecture", "Architecture"],
  ["decisions", "Design decisions"],
  ["ownership", "Technical ownership"],
  ["results", "Results & interpretation"],
  ["documentation", "Source & documentation"],
  ["limitations", "Limits & next steps"],
];
---
<div class="case-layout">
  <aside class="case-sidebar">
    <nav class="case-toc" aria-label="Case study sections">
      <p class="small-label">Inside this study</p>
      {sections.map(([id, title], index) => <a href={`#${id}`}><span>0{index + 1}</span>{title}</a>)}
      <a class="toc-source" href={project.sourceUrl}>Explore source <Icon name="arrow-up-right" size={15} /></a>
    </nav>
  </aside>
  <div class="case-content">
    <section id="problem" class="case-section">
      <p class="eyebrow">01 / Problem &amp; constraints</p><h2>The question behind the implementation.</h2>
      <div class="prose">{study.problem.map((paragraph) => <p>{paragraph}</p>)}</div>
      <div class="case-mandate"><span class="small-label">Engineering objective</span><p>{study.responsibility}</p></div>
    </section>
    <section id="architecture" class="case-section">
      <p class="eyebrow">02 / Architecture</p><h2>Make the boundaries explicit.</h2>
      <ol class="architecture-steps">{study.architecture.map((step, index) => <li><span class="small-label">0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
      <p class="case-note">{study.architectureNote}</p>
    </section>
    <section id="decisions" class="case-section">
      <p class="eyebrow">03 / Design decisions</p><h2>What I chose. What I ruled out.</h2>
      <div class="decisions-list">{study.decisions.map((decision) => (
        <article class="decision-card">
          <h3>{decision.title}</h3>
          <dl class="decision-options"><div><dt>Chosen approach</dt><dd>{decision.decision}</dd></div><div><dt>Alternative considered</dt><dd>{decision.alternative}</dd></div></dl>
          <p class="tradeoff"><strong>The trade-off.</strong> {decision.tradeoff}</p>
        </article>
      ))}</div>
    </section>
    <section id="ownership" class="case-section">
      <p class="eyebrow">04 / Technical ownership</p><h2>Turn decisions into reviewable work.</h2>
      <p class="case-intro">Independent project ownership: design, implementation and evaluation. My professional cross-team responsibilities are described separately in <a href={pathTo("/leadership/")}>Technical leadership</a>.</p>
      <div class="ownership-list">{study.ownership.map((item, index) => (
        <article><span class="small-label">0{index + 1}</span><div><h3>{item.title}</h3><p>{item.description}</p><a class="text-link" href={item.url}>{item.label} <Icon name="arrow-up-right" size={17} /></a></div></article>
      ))}</div>
    </section>
    <section id="results" class="case-section">
      <p class="eyebrow">05 / Results &amp; interpretation</p><h2>Evidence with its context intact.</h2>
      <div class="metrics">{study.results.map((result) => <article class="metric"><strong>{result.value}</strong><h3>{result.label}</h3><p>{result.description}</p></article>)}</div>
      <p class="case-note">{study.resultNote}</p>
    </section>
    <section id="documentation" class="case-section">
      <p class="eyebrow">06 / Implementation &amp; documentation</p><h2>Follow the claim back to its source.</h2>
      <div class="source-grid">{study.evidence.map((item) => <a class="source-card" href={item.url}><h3>{item.title}<Icon name="arrow-up-right" size={18} /></h3><p>{item.description}</p><span class="small-label">{item.label}</span></a>)}</div>
      <ProjectDocumentation project={project} />
      <details class="readme-disclosure" id="readme">
        <summary>Read the full project README<span>Implementation, setup, evaluation and limitations</span></summary>
        <div class="prose readme-body" set:html={project.readmeHtml} />
      </details>
    </section>
    <section id="limitations" class="case-section">
      <p class="eyebrow">07 / Limits &amp; production considerations</p><h2>Know where the evidence stops.</h2>
      <div class="prose"><p>{study.limitations}</p><h3>Before a production application</h3><p>{study.nextSteps}</p></div>
    </section>
  </div>
</div>
<style>
  .case-layout { display: grid; grid-template-columns: 205px minmax(0, 1fr); gap: 65px; padding-block: 60px; }
  .case-content { min-width: 0; }
  .case-toc { position: sticky; top: 117px; max-height: calc(100dvh - 150px); overflow-y: auto; font-size: 11px; }
  .case-toc > p { margin-bottom: 16px; }
  .case-toc > a { display: flex; align-items: center; gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--line); line-height: 1.65; }
  .case-toc a > span { color: var(--muted); font: 9px/1.8 var(--mono); flex-shrink: 0; }
  .case-toc .toc-source { margin-top: 17px; justify-content: space-between; color: var(--blue); border: 0; }
  .case-section { padding-block: 43px; border-bottom: 1px solid var(--line); scroll-margin-top: 104px; }
  .case-section:first-child { padding-top: 0; }
  .case-section:last-child { border: 0; padding-bottom: 0; }
  .case-section > .eyebrow { color: var(--blue); margin-bottom: 13px; }
  .case-section > h2 { font-size: 35px; margin-bottom: 27px; }
  .case-mandate { background: var(--sage); padding: 25px 28px; border-left: 3px solid #839f85; margin-top: 27px; }
  .case-mandate p { margin: 10px 0 0; font-size: 17px; line-height: 1.75; }
  .architecture-steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; padding: 0; margin: 0; gap: 15px; }
  .architecture-steps > li { padding: 24px; border: 1px solid var(--line); background: #edf1e9; margin: 0; }
  .architecture-steps .small-label { color: var(--blue); }
  .architecture-steps h3 { font-size: 20px; margin-top: 15px; margin-bottom: 13px; }
  .architecture-steps p { color: var(--muted); font-size: 14px; line-height: 1.8; margin: 0; }
  .case-note { padding: 23px 0 0; color: var(--muted); font-size: 14px; line-height: 1.85; margin: 0; }
  .decisions-list { display: grid; gap: 22px; }
  .decision-card { border: 1px solid var(--line); padding: 28px; border-radius: 3px; }
  .decision-card h3 { font-size: 23px; line-height: 1.25; margin-bottom: 23px; }
  .decision-options { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; margin: 0; }
  .decision-options dt { color: var(--blue); font: 10px/1.8 var(--mono); margin-bottom: 10px; }
  .decision-options dd { color: var(--muted); margin: 0; font-size: 14px; line-height: 1.8; }
  .tradeoff { font-size: 13px; line-height: 1.85; padding: 19px 0 0; border-top: 1px solid var(--line); margin: 24px 0 0; color: var(--muted); }
  .tradeoff strong { color: var(--ink); }
  .case-intro { color: var(--muted); font-size: 15px; line-height: 1.85; }
  .case-intro a { color: var(--blue); text-decoration: underline; }
  .ownership-list { display: grid; gap: 0; margin-top: 28px; }
  .ownership-list article { display: grid; grid-template-columns: 30px 1fr; gap: 20px; border-top: 1px solid var(--line); padding: 25px 0; }
  .ownership-list article:last-child { padding-bottom: 0; }
  .ownership-list h3 { font-size: 22px; margin-bottom: 12px; }
  .ownership-list p { color: var(--muted); font-size: 14px; line-height: 1.8; }
  .ownership-list .text-link { font-size: 12px; }
  .metric h3 { font-size: 19px; margin-bottom: 13px; }
  .metric p { color: var(--muted); font-size: 13px; line-height: 1.8; margin-bottom: 0; }
  .source-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 17px; }
  .source-card { display: block; padding: 25px; border: 1px solid var(--line); border-radius: 3px; }
  .source-card:hover { background: var(--sage); }
  .source-card h3 { display: flex; align-items: start; justify-content: space-between; gap: 16px; font-size: 19px; line-height: 1.25; margin-bottom: 15px; }
  .source-card :global(svg) { flex-shrink: 0; }
  .source-card p { color: var(--muted); font-size: 13px; line-height: 1.8; margin-bottom: 12px; }
  .source-card .small-label { font-size: 9px; overflow-wrap: anywhere; }
  .readme-disclosure { margin-top: 25px; border: 1px solid var(--line); border-radius: 3px; }
  .readme-disclosure > summary { padding: 21px 24px; font-size: 14px; font-weight: 600; cursor: pointer; }
  .readme-disclosure > summary > span { display: block; margin: 7px 0 0 16px; color: var(--muted); font: 10px/1.8 var(--mono); }
  .readme-body { padding: 25px; border-top: 1px solid var(--line); }
  @media (max-width: 1000px) {
    .case-layout { grid-template-columns: 165px minmax(0, 1fr); gap: 35px; }
    .case-toc { font-size: 10px; }
    .case-section > h2 { font-size: 30px; }
    .architecture-steps > li, .decision-card, .source-card { padding: 21px; }
    .decision-options { gap: 21px; }
    .metrics { gap: 16px; }
    .metric { padding: 23px; }
  }
  @media (max-width: 700px) {
    .case-layout { grid-template-columns: minmax(0, 1fr); padding-top: 30px; gap: 32px; }
    .case-toc { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; max-height: none; font-size: 10px; }
    .case-toc > p, .case-toc .toc-source { grid-column: 1 / -1; }
    .case-toc .toc-source { justify-content: start; margin-top: 10px; }
    .case-section { padding-block: 33px; scroll-margin-top: 93px; }
    .case-section > h2 { font-size: 29px; margin-bottom: 22px; }
    .case-mandate { padding: 22px; }
    .case-mandate p { font-size: 15px; }
    .architecture-steps, .decision-options, .source-grid { grid-template-columns: 1fr; }
    .architecture-steps h3 { font-size: 22px; }
    .decision-card h3 { font-size: 23px; }
    .decision-options { gap: 23px; }
    .ownership-list article { grid-template-columns: 21px 1fr; gap: 14px; }
    .ownership-list h3 { font-size: 22px; }
    .source-card { padding: 23px; }
    .source-card h3 { font-size: 21px; }
    .readme-body { padding: 20px 16px; }
  }
</style>
