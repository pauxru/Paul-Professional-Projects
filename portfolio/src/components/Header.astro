---
import Icon from "./Icon.astro";
import { pathTo } from "../lib/urls";
const links = [
  { label: "Projects", path: "/projects/" },
  { label: "Experience", path: "/experience/" },
  { label: "Leadership", path: "/leadership/" },
  { label: "Notes", path: "/notes/" },
  { label: "Resume", path: "/resume/" },
];
---
<header class="site-header" data-site-header>
  <div class="wrap header-inner">
    <a href={pathTo("/")} class="brand" aria-label="Paul Rukwaro, home">
      <span class="brand-mark" aria-hidden="true">PR<span></span></span>
      <span>Paul Rukwaro<span class="brand-caption">Software engineering</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-nav-toggle hidden>
      <span data-menu-label>Menu</span><Icon name="menu" />
    </button>
    <nav class="site-nav" id="primary-navigation" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={pathTo(link.path)} aria-current={Astro.url.pathname.startsWith(pathTo(link.path)) ? "page" : undefined}>{link.label}</a>
      ))}
      <a class="nav-contact" href={pathTo("/contact/")} aria-current={Astro.url.pathname === pathTo("/contact/") ? "page" : undefined}>
        Get in touch <Icon name="arrow-up-right" size={16} />
      </a>
    </nav>
  </div>
</header>
