---
import type { Project } from "../data/types";
import Icon from "./Icon.astro";
interface Props { project: Project }
const { project } = Astro.props;
---
<div class="documentation-links">
  <a class="text-link" href={project.readmeUrl}>Original README <Icon name="arrow-up-right" size={17} /></a>
  <a class="text-link" href={project.docsUrl}>Documentation on GitHub <Icon name="arrow-up-right" size={17} /></a>
  <a class="text-link" href={project.sourceUrl}>Implementation source <Icon name="arrow-up-right" size={17} /></a>
</div>
<details class="document-index">
  <summary>Browse supporting documentation <span>{project.documentationCount} documents / {project.decisionRecordCount} decision records</span></summary>
  <ul>
    {project.documents.map((document) => <li><a href={document.url}>{document.title}<Icon name="arrow-up-right" size={15} /></a><span>{document.kind}</span></li>)}
  </ul>
</details>
<style>
  .documentation-links { display: flex; flex-wrap: wrap; gap: 14px 25px; margin-block: 25px; }
  .documentation-links .text-link { font-size: 12px; }
  .document-index { border: 1px solid var(--line); border-radius: 3px; margin-top: 25px; }
  summary { padding: 20px 24px; font-weight: 600; cursor: pointer; font-size: 14px; }
  summary span { display: block; margin: 7px 0 0 16px; font: 10px/1.8 var(--mono); font-weight: 400; color: var(--muted); }
  ul { list-style: none; margin: 0; padding: 0 24px 15px; }
  li { display: flex; justify-content: space-between; gap: 20px; align-items: baseline; border-top: 1px solid var(--line); padding: 12px 0; margin: 0; }
  li a { display: flex; align-items: center; gap: 12px; font-size: 13px; overflow-wrap: anywhere; }
  li :global(svg) { flex-shrink: 0; }
  li > span { font: 9px/1.8 var(--mono); color: var(--muted); text-align: right; flex-shrink: 0; }
  @media (max-width: 700px) {
    summary { padding: 19px; }
    ul { padding-inline: 19px; }
    li { display: block; }
    li > span { display: block; text-align: left; margin-top: 5px; }
  }
</style>
