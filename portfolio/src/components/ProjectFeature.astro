---
import type { Project, CaseStudy } from "../data/types";
import Icon from "./Icon.astro";
import { pathTo } from "../lib/urls";
interface Props { project: Project; study: CaseStudy; variant?: "wide" | "compact" }
const { project, study, variant = "compact" } = Astro.props;
---
<article class:list={["project-feature", `theme-${study.theme}`, variant]}>
  <div class="feature-copy">
    <div class="project-kicker"><span class="project-number">{project.number}</span><span>{study.setting}</span></div>
    <h3><a href={pathTo(`/projects/${project.slug}/`)}>{project.title}</a></h3>
    <p>{study.summary}</p>
    <div class="tag-row">{project.languages.map((language) => <span class="tag">{language}</span>)}</div>
    <a class="project-link" href={pathTo(`/projects/${project.slug}/`)}>
      Read the case study <Icon name="arrow-up-right" />
      <span class="sr-only">: {project.title}</span>
    </a>
  </div>
  <figure class="feature-art">
    <picture>
      {study.mobileImage && <source media="(max-width: 600px)" srcset={pathTo(`/images/${study.mobileImage}`)} />}
      <img src={pathTo(`/images/${study.image}`)} alt={study.imageAlt} loading="lazy" decoding="async" width="600" height={study.theme === "bridge" ? 360 : 290} />
    </picture>
    <figcaption>{study.theme === "retrieval" ? "Controlled synthetic comparison" : study.theme === "observability" ? "Conceptual signal illustration" : "Conceptual architecture illustration"}</figcaption>
  </figure>
</article>
