---
// Reusable career-pathway card for the contact page: a label, a heading,
// a short description, suggested message details and a slot for real links.
interface Props {
  label: string;
  title: string;
  description: string;
  points: string[];
}
const { label, title, description, points } = Astro.props;
---
<article class="career-card pathway-card">
  <span class="small-label">{label}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <p class="pathway-points-label small-label">Useful to include</p>
  <ul class="detail-list pathway-points">{points.map((point) => <li>{point}</li>)}</ul>
  <div class="pathway-links"><slot /></div>
</article>
<style>
  .pathway-card { gap: 4px; }
  .pathway-card h3 { margin-top: 12px; margin-bottom: 10px; }
  .pathway-points-label { margin-top: 18px; margin-bottom: 10px; }
  .pathway-points { font-size: 13px; line-height: 1.75; margin: 0; }
  .pathway-links { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: auto; padding-top: 20px; }
</style>
