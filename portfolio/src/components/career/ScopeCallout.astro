---
// Shared boundary note for career pages: keeps CV-grounded professional
// history/leadership clearly separate from independent project ownership.
interface Props {
  heading: string;
}
const { heading } = Astro.props;
---
<aside class="callout scope-callout">
  <strong>{heading}</strong>
  <p><slot /></p>
</aside>
<style>
  .scope-callout { display: grid; gap: 8px; }
  .scope-callout strong { display: block; color: var(--ink); font-size: 13px; letter-spacing: -.01em; }
  .scope-callout p { margin: 0; font-size: 14px; line-height: 1.85; }
  .scope-callout :global(a) { color: #1d43bd; text-decoration: underline; text-underline-offset: 2px; }
</style>
