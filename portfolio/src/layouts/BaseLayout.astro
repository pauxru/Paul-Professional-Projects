---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import profile from "../data/profile.json";
import { absoluteUrl, pathTo } from "../lib/urls";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
}
const {
  title,
  description = "Paul Rukwaro, Senior Software Engineer. Production experience at Microsoft, in financial services and enterprise platforms, with 50 documented engineering projects.",
  type = "website",
  noindex = false,
  breadcrumbs = [],
} = Astro.props;
const site = Astro.site;
if (!site) throw new Error("A configured Astro site is required for canonical URLs.");
const pageTitle = title ? `${title} | Paul Rukwaro` : "Paul Rukwaro | Senior Software Engineer";
const canonical = new URL(Astro.url.pathname, site).href;
const home = absoluteUrl("/", site);
const personId = `${home}#person`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: profile.name,
      jobTitle: profile.title,
      url: home,
      description: profile.summary,
      sameAs: [profile.linkedin, profile.github],
      knowsAbout: ["Distributed systems", "Database-backed services", "Cloud infrastructure", "Software engineering"],
    },
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: "Paul Rukwaro - Engineering Portfolio",
      url: home,
      author: { "@id": personId },
      inLanguage: "en",
    },
    ...(breadcrumbs.length ? [{
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: absoluteUrl(crumb.path, site),
      })),
    }] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f5f5f0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={pathTo("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={pathTo("/favicon-32.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={pathTo("/apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title="Paul Rukwaro - Engineering notes" href={pathTo("/rss.xml")} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Paul Rukwaro" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={absoluteUrl("/images/social-card.png", site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Paul Rukwaro - Senior Software Engineer. Distributed systems, databases and cloud infrastructure." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl("/images/social-card.png", site)} />
    <meta name="twitter:image:alt" content="Paul Rukwaro - Senior Software Engineer" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
