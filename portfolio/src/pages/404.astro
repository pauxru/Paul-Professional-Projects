---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { pathTo } from "../lib/urls";
---
<BaseLayout title="Page not found" description="This page could not be found. Explore Paul Rukwaro's projects, professional experience or engineering notes." noindex>
  <section class="wrap page-hero not-found">
    <p class="eyebrow">404 / Page not found</p>
    <h1>A different route<br />to the right place.</h1>
    <p class="lead">The address may have changed or the link may be incomplete. The project library and homepage are good places to start.</p>
    <div class="button-row"><a class="button" href={pathTo("/projects/")}>Explore the projects <Icon name="arrow-up-right" /></a><a class="button secondary" href={pathTo("/")}>Return home <Icon name="arrow-right" /></a></div>
  </section>
</BaseLayout>
<style>.not-found { padding-block: 85px 110px; min-height: 65vh; } @media (max-width:700px) { .not-found { padding-block: 55px 70px; } }</style>
