---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ScopeCallout from "../components/career/ScopeCallout.astro";
import profile from "../data/profile.json";
import { pathTo } from "../lib/urls";

// Matches the anchor ids the homepage's experience strip links into
// (pathTo(`/experience/#${company.toLowerCase().replaceAll(" ", "-")}`)).
const slugify = (value: string) => value.toLowerCase().replaceAll(" ", "-");
const currentRole = profile.experience.find((job) => job.end === "Present");
const inProgressDegree = profile.education.find((entry) => entry.status === "In progress");
---
<BaseLayout
  title="Experience"
  description={`Professional experience across ${profile.experience.length} engineering roles, from ${profile.experience[profile.experience.length - 1].company} to ${profile.experience[0].company}, with exact dates, responsibilities and toolkit.`}
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Experience", path: "/experience/" }]}
>
  <section class="wrap page-hero experience-hero">
    <p class="eyebrow">Professional experience</p>
    <h1>Engineering across products,<br /><span class="blue">platforms and constraints.</span></h1>
    <p class="lead">{profile.summary}</p>
    <dl class="fact-grid">
      {currentRole && <div><dt>Current role</dt><dd>{currentRole.role}, {currentRole.company} ({currentRole.start}&ndash;{currentRole.end})</dd></div>}
      <div><dt>Professional path</dt><dd>{profile.experience.length} roles across {profile.experience.map((job) => job.company).join(", ")} since {profile.experience[profile.experience.length - 1].start.split(" ")[1]}</dd></div>
      {inProgressDegree && <div><dt>Continuing study</dt><dd>{inProgressDegree.qualification}, {inProgressDegree.institution} ({inProgressDegree.dates}, {inProgressDegree.status.toLowerCase()})</dd></div>}
    </dl>
    <nav class="experience-jump" aria-label="Jump to a role">
      <span class="small-label">Jump to:</span>
      {profile.experience.map((job) => <a href={`#${slugify(job.company)}`}>{job.company}</a>)}
    </nav>
  </section>

  <section class="wrap section section-tight" aria-labelledby="roles-heading">
    <h2 id="roles-heading" class="sr-only">Role history</h2>
    <div class="timeline experience-timeline">
      {profile.experience.map((job) => (
        <article class="timeline-item" id={slugify(job.company)}>
          <div class="timeline-meta">{job.start}<br /><span>{job.end}</span></div>
          <div class="timeline-content">
            <h3>{job.company}</h3>
            <p class="timeline-role">{job.role} &middot; {job.context}</p>
            <p>{job.summary}</p>
            <ul class="detail-list">{job.responsibilities.map((item) => <li>{item}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="toolkit-heading">
    <div class="section-head">
      <div><p class="eyebrow">Toolkit</p><h2 id="toolkit-heading">What I build with.</h2></div>
      <p>The languages, platforms and operating practices behind the work above.</p>
    </div>
    <div class="card-grid">
      {profile.skills.map((group) => (
        <div class="info-card">
          <h3>{group.area}</h3>
          <div class="tag-row">{group.items.map((item) => <span class="tag">{item}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section section-tight education-credentials" aria-labelledby="education-heading">
    <div class="split-layout">
      <div>
        <p class="eyebrow">Education</p>
        <h2 id="education-heading">Formal study, alongside the work.</h2>
        <dl class="education-list">
          {profile.education.map((entry) => (
            <div class="education-entry">
              <dt><strong>{entry.qualification}</strong></dt>
              <dd>{entry.institution} &middot; {entry.dates} &middot; {entry.status}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <p class="eyebrow">Prior credentials</p>
        <h2>Earlier coursework &amp; certificates.</h2>
        <dl class="education-list">
          {profile.priorCredentials.map((entry) => (
            <div class="education-entry">
              <dt><strong>{entry.name}</strong></dt>
              <dd>{entry.issuer} &middot; {entry.earned}{entry.note && <><br /><span class="muted">{entry.note}</span></>}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="wrap section-tight" style="padding-bottom: 70px;">
    <ScopeCallout heading="Professional roles vs. independent projects">
      This page documents responsibilities held within my employment. Cross-team technical leadership drawn from these roles is detailed on the <a href={pathTo("/leadership/")}>Leadership</a> page. My independent engineering studies are self-directed work, separate from any employer's systems or deliverables &mdash; explore them in the <a href={pathTo("/projects/")}>project library</a>.
    </ScopeCallout>
    <div class="button-row">
      <a class="button" href={pathTo("/leadership/")}>How this translates into leadership <Icon name="arrow-up-right" /></a>
      <a class="button secondary" href={pathTo("/resume/")}>View printable resume <Icon name="arrow-right" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .experience-hero { padding-bottom: 30px; }
  .experience-hero h1 { max-width: 900px; }
  .experience-hero .lead { max-width: 780px; }
  .experience-jump { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 30px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 13px; }
  .experience-jump a { text-decoration: underline; text-underline-offset: 3px; }
  .experience-timeline { max-width: 980px; }
  .experience-timeline .timeline-content h3 { font-size: 26px; margin-bottom: 6px; }
  .timeline-role { font-weight: 600; color: var(--muted); font-size: 14px; margin-bottom: 10px; }
  .education-credentials .split-layout > div > h2 { font-size: 26px; margin-bottom: 20px; }
  .education-list { padding-left: 0; margin: 0; }
  .education-entry { border-top: 1px solid var(--line); padding: 18px 0; }
  .education-entry:first-child { border-top: 0; padding-top: 0; }
  .education-entry dt { margin-bottom: 6px; }
  .education-entry dd { margin: 0; font-size: 14px; line-height: 1.8; }
  @media (max-width: 700px) {
    .experience-hero h1 { font-size: clamp(38px, 10.5vw, 54px); }
    .fact-grid dd { font-size: 14px; }
    .experience-jump { gap: 8px 12px; font-size: 12px; }
    .experience-timeline .timeline-content h3 { font-size: 23px; }
  }
</style>
