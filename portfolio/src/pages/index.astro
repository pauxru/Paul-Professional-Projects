---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ProjectFeature from "../components/ProjectFeature.astro";
import profile from "../data/profile.json";
import { projects } from "../data/projects";
import { caseStudies } from "../data/case-studies";
import { notes } from "../data/notes";
import { pathTo } from "../lib/urls";

const selected = caseStudies.map((study) => {
  const project = projects.find((entry) => entry.number === study.number);
  if (!project) throw new Error(`Missing selected project ${study.number}`);
  return { study, project };
});
const [featured, ...otherStudies] = selected;
if (!featured) throw new Error("The homepage requires at least one selected case study.");
---
<BaseLayout>
  <section class="home-hero wrap" aria-labelledby="hero-heading">
    <div class="hero-meta">
      <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Senior Software Engineer</p>
      <span class="small-label">Nairobi, Kenya / Working across systems</span>
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-heading" class="hero-title"><span>Technical depth.</span><span>Clear direction.</span><em>Dependable<br />delivery.</em></h1>
        <p class="hero-lead">{profile.summary}</p>
        <p class="hero-specialties">Distributed systems / Databases / Cloud infrastructure</p>
        <div class="button-row">
          <a class="button" href={pathTo("/projects/")}>Explore my work <Icon name="arrow-up-right" /></a>
          <a class="button secondary" href={pathTo("/experience/")}>View experience <Icon name="arrow-right" /></a>
        </div>
      </div>
      <figure class="hero-visual">
        <img src={pathTo("/images/systems.svg")} alt="Exploded systems diagram separating the application layer, explicit contracts and a trusted computational core." width="600" height="600" fetchpriority="high" />
        <figcaption><span>Architecture, implementation, operations.</span><span>Conceptual study</span></figcaption>
      </figure>
    </div>
  </section>

  <div class="wrap">
    <section class="experience-strip" aria-label="Professional experience">
      <span class="small-label strip-label">Professional<br />experience</span>
      {profile.experience.map((job) => <a href={pathTo(`/experience/#${job.company.toLowerCase().replaceAll(" ", "-")}`)}><strong>{job.company}</strong><span>{job.start.split(" ")[1]} &mdash; {job.end === "Present" ? "Present" : job.end.split(" ")[1]}</span></a>)}
    </section>
    <nav class="shortcut-strip" aria-label="Career resources">
      <span class="small-label">A starting point for your conversation</span>
      <a href={pathTo("/resume/")}>Resume &amp; background <Icon name="arrow-up-right" size={15} /></a>
      <a href={pathTo("/leadership/")}>Technical leadership <Icon name="arrow-up-right" size={15} /></a>
      <a href={pathTo("/notes/")}>Engineering decisions <Icon name="arrow-up-right" size={15} /></a>
    </nav>
  </div>

  <section id="work" class="wrap section" aria-labelledby="work-heading">
    <div class="section-head">
      <div><p class="eyebrow">01 / Selected engineering work</p><h2 id="work-heading">Decisions, not just deliverables.</h2></div>
      <p>Three independent studies, examined in depth: the problem, the architecture, the trade-offs and the evidence.</p>
    </div>
    <ProjectFeature {...featured} variant="wide" />
    <div class="feature-pair">{otherStudies.map((item) => <ProjectFeature {...item} />)}</div>
    <div class="library-bar">
      <p><strong>{projects.length} projects.</strong> Production-system reference designs, modernization and AI application engineering.</p>
      <a class="text-link" href={pathTo("/projects/")}>Explore the full library <Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="leadership-band" aria-labelledby="leadership-heading">
    <div class="wrap leadership-grid">
      <div>
        <p class="eyebrow">02 / Technical leadership</p>
        <h2 id="leadership-heading">Set direction.<br />Align execution.<br /><em>Own the outcome.</em></h2>
        <p>My leadership combines hands-on engineering with technical direction, cross-team coordination and responsibility for how systems behave in operation.</p>
        <a class="text-link light-link" href={pathTo("/leadership/")}>How I lead technical work <Icon name="arrow-up-right" /></a>
      </div>
      <div class="leadership-items">
        {profile.leadership.map((item, index) => (
          <article>
            <span class="small-label">0{index + 1}</span>
            <div><p class="leadership-context">{item.context}</p><h3>{item.title}</h3><p>{item.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="experience-heading">
    <div class="split-layout experience-summary">
      <div>
        <p class="eyebrow">03 / Professional experience</p>
        <h2 id="experience-heading">Engineering across<br />different constraints.</h2>
        <p class="lead">Platform engineering at Microsoft. Financial-system integrations at Prime Bank. Database-intensive enterprise software at Indra.</p>
        <p class="muted">The context changes. The responsibility remains: understand the system, make deliberate decisions and follow through to dependable operation.</p>
        <a class="text-link" href={pathTo("/experience/")}>Explore my experience <Icon name="arrow-up-right" /></a>
        <div class="education-brief">
          <span class="small-label">Continuing technical development</span>
          <strong>MSc Computer Science</strong>
          <span>Georgia Institute of Technology</span>
          <span class="muted">2026&ndash;present / In progress</span>
        </div>
      </div>
      <div class="timeline">
        {profile.experience.map((job) => (
          <article class="timeline-item">
            <div class="timeline-meta">{job.start}<br /><span>{job.end}</span></div>
            <div class="timeline-content"><h3>{job.company}</h3><p class="timeline-role">{job.role}</p><p>{job.summary}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section section-tight" aria-labelledby="notes-heading">
    <div class="section-head">
      <div><p class="eyebrow">04 / Engineering notes</p><h2 id="notes-heading">The reasoning behind the work.</h2></div>
      <a class="text-link" href={pathTo("/notes/")}>All notes <Icon name="arrow-right" /></a>
    </div>
    <div class="home-note-grid">
      {notes.map((note) => (
        <article class="home-note">
          <p class="small-label">{note.topic}</p>
          <h3><a href={pathTo(`/notes/${note.slug}/`)}>{note.title}</a></h3>
          <p>{note.summary}</p>
          <a class="text-link" href={pathTo(`/notes/${note.slug}/`)}>Read the note <Icon name="arrow-up-right" size={17} /><span class="sr-only">: {note.title}</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="career-heading">
    <div class="section-head">
      <div><p class="eyebrow">05 / Start with what matters</p><h2 id="career-heading">Different conversations.<br />A clear point of reference.</h2></div>
      <p>For people evaluating my experience, examining the engineering or exploring a professional relationship.</p>
    </div>
    <div class="career-grid">
      <article class="career-card"><span class="small-label">Experience &amp; leadership</span><h3>Understand my contribution.</h3><p>A concise professional history, technical responsibilities and a public resume for hiring, referrals and career discussions.</p><a class="text-link" href={pathTo("/resume/")}>Open career materials <Icon name="arrow-up-right" /></a></article>
      <article class="career-card"><span class="small-label">Technical evaluation</span><h3>Examine the decisions.</h3><p>Architecture, implementation, alternatives, limitations and source evidence for interviews, engineering review and collaboration.</p><a class="text-link" href={pathTo("/projects/")}>Explore the engineering <Icon name="arrow-up-right" /></a></article>
      <article class="career-card"><span class="small-label">Professional relationships</span><h3>Begin a useful conversation.</h3><p>Connect around systems engineering, shared technical interests, product challenges, collaboration or consulting.</p><a class="text-link" href={pathTo("/contact/")}>Get in touch <Icon name="arrow-up-right" /></a></article>
    </div>
  </section>

  <section class="contact-band" aria-labelledby="contact-heading">
    <div class="wrap"><div><p class="eyebrow">A good conversation starts with context.</p><h2 id="contact-heading">Let's talk engineering.</h2><p>Share the system, the challenge or the opportunity you have in mind.</p></div><a class="button" href={pathTo("/contact/")}>Start a conversation <Icon name="arrow-up-right" /></a></div>
  </section>
</BaseLayout>
