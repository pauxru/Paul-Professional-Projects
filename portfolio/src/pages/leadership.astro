---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ScopeCallout from "../components/career/ScopeCallout.astro";
import profile from "../data/profile.json";
import { pathTo } from "../lib/urls";

const slugify = (value: string) => value.toLowerCase().replaceAll(" ", "-");

const employerLinks = (companies: string[]) => companies.map((company) => {
  const job = profile.experience.find((entry) => entry.company === company);
  if (!job) throw new Error(`Leadership references an unknown employer: ${company}`);
  return { label: job.company, href: pathTo(`/experience/#${slugify(job.company)}`) };
});

const leadership = profile.leadership.map((item) => ({
  ...item,
  id: slugify(item.title),
  employers: employerLinks(item.employers),
}));
---
<BaseLayout
  title="Leadership"
  description="How I exercise technical leadership within my professional roles at Microsoft and Prime Bank Kenya, kept distinct from the independent ownership of my self-directed engineering studies."
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Leadership", path: "/leadership/" }]}
>
  <section class="wrap page-hero">
    <p class="eyebrow">How I lead technical work</p>
    <h1>Set direction. Align execution.<br /><span class="blue">Own the outcome.</span></h1>
    <p class="lead">I combine hands-on engineering with technical direction, cross-team alignment and operational responsibility. My contributions span design reviews, testing strategy and coordinated investigation across system boundaries.</p>
  </section>

  <section class="wrap section-tight leadership-scope">
    <ScopeCallout heading="Professional leadership and independent practice">
      The professional examples below come from my work at <a href={pathTo("/experience/#microsoft")}>Microsoft</a> and <a href={pathTo("/experience/#prime-bank-kenya")}>Prime Bank Kenya</a>. The project library provides a separate view of my approach to architecture, implementation and evaluation through self-directed engineering work.
    </ScopeCallout>
  </section>

  <section class="wrap section section-tight" aria-labelledby="professional-leadership-heading">
    <div class="section-head">
      <div><p class="eyebrow">01 / Professional technical leadership</p><h2 id="professional-leadership-heading">Direction, alignment and delivery.</h2></div>
      <p>Technical responsibilities across engineering teams and production workflows.</p>
    </div>
    <div class="content-stack leadership-detail">
      {leadership.map((item, index) => (
        <article class="info-card leadership-card" id={item.id}>
          <span class="small-label">0{index + 1}</span>
          <p class="leadership-context small-label">{item.context}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <div class="leadership-evidence">
            <span class="small-label">Professional context</span>
            <div class="tag-row">
              {item.employers.map((employer) => <a class="text-link" href={employer.href}>{employer.label} <Icon name="arrow-up-right" size={14} /></a>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section section-tight" aria-labelledby="independent-ownership-heading">
    <div class="section-head">
      <div><p class="eyebrow">02 / Independent project ownership</p><h2 id="independent-ownership-heading">From scope to implementation.</h2></div>
      <p>Architecture, implementation and evaluation.</p>
    </div>
    <div class="surface-card independent-ownership">
      <p>These self-directed studies cover scope, architecture, implementation and evaluation. Each explores a specific engineering question; they are distinct from employer deliverables or customer case histories.</p>
      <p>The repository records alternatives, design decisions, evaluation findings and limitations so another engineer can inspect the reasoning or reproduce the work.</p>
      <div class="button-row">
        <a class="button secondary" href={pathTo("/projects/")}>Explore the project library <Icon name="arrow-up-right" /></a>
        <a class="text-link" href={pathTo("/notes/")}>Read the engineering notes <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <section class="wrap section-tight" style="padding-bottom: 70px;">
    <div class="button-row">
      <a class="button" href={pathTo("/experience/")}>Review my professional experience <Icon name="arrow-up-right" /></a>
      <a class="button secondary" href={pathTo("/contact/")}>Discuss a role or a system <Icon name="arrow-right" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .leadership-scope { margin-bottom: 44px; }
  .leadership-detail { max-width: 900px; }
  .leadership-card { display: grid; gap: 10px; }
  .leadership-context { color: var(--blue); }
  .leadership-card h3 { font-size: 22px; }
  .leadership-evidence { margin-top: 6px; padding-top: 16px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .leadership-evidence .tag-row { gap: 14px; }
  .independent-ownership { max-width: 900px; }
  .independent-ownership p { color: var(--muted); font-size: 15px; line-height: 1.85; }
  @media (max-width: 700px) {
    .leadership-card h3 { font-size: 21px; }
  }
</style>
