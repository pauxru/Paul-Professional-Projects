---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { notes } from "../../data/notes";
import { projects } from "../../data/projects";
import { pathTo } from "../../lib/urls";
import type { EngineeringNote } from "../../data/types";
import { formatDate, readingMinutes } from "../../lib/format";

export function getStaticPaths() {
  return notes.map((note) => ({ params: { slug: note.slug }, props: { note } }));
}
interface Props { note: EngineeringNote }
const { note } = Astro.props;

const project = projects.find((item) => item.number === note.projectNumber);
if (!project) throw new Error(`Note ${note.slug} references an unknown project.`);
const sortedNotes = [...notes].sort((a, b) => new Date(b.published).getTime() - new Date(a.published).getTime());
const currentIndex = sortedNotes.findIndex((item) => item.slug === note.slug);
const nextNote = sortedNotes.length > 1 ? sortedNotes[(currentIndex + 1) % sortedNotes.length] : undefined;
---
<BaseLayout
  title={note.title}
  description={note.summary}
  type="article"
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Notes", path: "/notes/" }, { name: note.title, path: `/notes/${note.slug}/` }]}
>
  <div class="wrap">
    <section class="page-hero note-hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={pathTo("/notes/")}>Engineering notes</a><span aria-hidden="true">/</span><span>{note.topic}</span></nav>
      <p class="eyebrow">
        <time datetime={note.published}>{formatDate(note.published)}</time>
        <span aria-hidden="true"> &middot; </span>{readingMinutes(note)} min read
        <span aria-hidden="true"> &middot; </span>{note.topic}
      </p>
      <h1>{note.title}</h1>
      <p class="lead">{note.summary}</p>
      <p class="note-provenance muted">Independent technical analysis, with implementation references below.</p>
    </section>

    {project && (
      <p class="callout note-evidence">
        <strong>From the project.</strong> This note follows from <a href={pathTo(`/projects/${project.slug}/`)}>{project.title}</a> (project {String(project.number).padStart(2, "0")}). Read the <a href={project.sourceUrl}>source</a> or the <a href={project.docsUrl}>design documentation</a> for the full implementation and decision records this note draws on.
      </p>
    )}

    <article class="prose note-body">
      {note.sections.map((section) => (
        <>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.code && <pre><code>{section.code}</code></pre>}
        </>
      ))}
    </article>

    <nav class="note-pagination" aria-label="Continue reading">
      <a href={pathTo("/notes/")}><span class="small-label">All notes</span><strong>Back to engineering notes <Icon name="arrow-right" /></strong></a>
      {nextNote && <a href={pathTo(`/notes/${nextNote.slug}/`)}><span class="small-label">Next note</span><strong>{nextNote.title} <Icon name="arrow-up-right" /></strong></a>}
    </nav>
  </div>
</BaseLayout>

<style>
  .note-hero { padding-bottom: 22px; }
  .note-hero h1 { max-width: 900px; }
  .note-hero .lead { max-width: 780px; }
  .note-provenance { font-size: 12px; margin-top: 14px; margin-bottom: 0; }
  .note-evidence { max-width: 900px; margin-bottom: 40px; }
  .note-evidence a { color: #1d43bd; text-decoration: underline; }
  .note-body { max-width: 780px; padding-bottom: 20px; }
  .note-pagination { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding: 30px 0 60px; border-top: 1px solid var(--line); margin-top: 30px; }
  .note-pagination > a { display: grid; gap: 10px; }
  .note-pagination > a:last-child { text-align: right; }
  .note-pagination strong { display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 18px; font-weight: 600; }
  @media (max-width: 700px) {
    .note-hero h1 { font-size: clamp(34px, 9vw, 48px); overflow-wrap: anywhere; }
    .note-pagination { grid-template-columns: 1fr; gap: 24px; }
    .note-pagination > a:last-child { text-align: left; }
  }
</style>
