---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import CaseStudyBody from "../../components/CaseStudyBody.astro";
import ProjectDocumentation from "../../components/ProjectDocumentation.astro";
import { projects, tracks } from "../../data/projects";
import { caseStudies } from "../../data/case-studies";
import type { Project } from "../../data/types";
import { pathTo } from "../../lib/urls";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project }
const { project } = Astro.props;
const study = caseStudies.find((item) => item.number === project.number);
const track = tracks.find((item) => item.id === project.track);
if (!track) throw new Error(`Unknown track for project ${project.number}`);
const nextStudy = study ? caseStudies[(caseStudies.indexOf(study) + 1) % caseStudies.length] : undefined;
const nextProject = nextStudy ? projects.find((item) => item.number === nextStudy.number) : projects[project.number % projects.length];
const toc = project.headings.filter((heading) => heading.level <= 3);
---
<BaseLayout title={project.title} description={project.summary} type="article" breadcrumbs={[{ name: "Home", path: "/" }, { name: "Projects", path: "/projects/" }, { name: project.title, path: `/projects/${project.slug}/` }]}>
  <div class="wrap">
    <section class="page-hero project-hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={pathTo("/projects/")}>Project library</a><span aria-hidden="true">/</span><a href={`${pathTo("/projects/")}?track=${project.track}`}>{track.label}</a><span aria-hidden="true">/</span><span>{String(project.number).padStart(2, "0")}</span></nav>
      <p class="eyebrow">{study ? "Independent case study" : "Independent engineering project"} / {project.title}</p>
      <h1>{study ? <><span>{study.leading}</span><em>{study.accent}</em></> : project.title}</h1>
      <p class="lead">{study?.summary ?? project.summary}</p>
      <div class="button-row"><a class="button" href={project.sourceUrl}>View implementation <Icon name="arrow-up-right" /></a><a class="button secondary" href="#documentation">Explore documentation <Icon name="arrow-down" /></a></div>
      <dl class="fact-grid">
        <div><dt>Contribution</dt><dd>Independent design, implementation and evaluation</dd></div>
        <div><dt>{study ? "Environment" : "Languages"}</dt><dd>{study?.setting ?? project.languages.join(" / ")}</dd></div>
        <div><dt>Engineering focus</dt><dd>{study?.focus ?? project.focus.join(" / ")}</dd></div>
      </dl>
      <p class="project-scope"><strong>Scope.</strong> {study ? study.limitations : project.scope}</p>
    </section>

    {study && <figure class="case-hero-visual"><div class:list={["case-art-stage", `theme-${study.theme}`]}><picture>{study.mobileImage && <source media="(max-width: 600px)" srcset={pathTo(`/images/${study.mobileImage}`)} />}<img src={pathTo(`/images/${study.image}`)} width="760" height="430" alt={study.imageAlt} fetchpriority="high" /></picture></div><figcaption>{study.imageCaption}</figcaption></figure>}

    {study ? <CaseStudyBody study={study} project={project} /> : (
      <div class="reference-layout">
        <aside class="reference-sidebar">
          <nav aria-label="Project documentation sections"><p class="small-label">Inside the implementation</p>{toc.map((heading) => <a href={`#${heading.id}`}>{heading.text}</a>)}<a href="#documentation">Supporting documents</a></nav>
        </aside>
        <div class="reference-main">
          <section class="readme-introduction"><p class="eyebrow">Implementation &amp; evaluation</p><p>The project README is reproduced below, with links to the implementation, design records and operating instructions. Scenario narratives describe an independent project, not a customer deployment.</p><a class="text-link" href={project.readmeUrl}>Read on GitHub <Icon name="arrow-up-right" size={17} /></a></section>
          <article class="prose project-readme" aria-label={`${project.title} README`} set:html={project.readmeHtml} />
          <section id="documentation" class="supporting-documents"><p class="eyebrow">Source &amp; documentation</p><h2>Continue into the implementation.</h2><p class="muted">The source repository contains setup instructions, design decisions, evaluation guidance and the project's stated limitations.</p><ProjectDocumentation project={project} /></section>
        </div>
      </div>
    )}

    <nav class="project-pagination" aria-label="Continue exploring">
      <a href={pathTo("/projects/")}><span class="small-label">The complete collection</span><strong>Back to all {projects.length} projects <Icon name="arrow-right" /></strong></a>
      {nextProject && <a href={pathTo(`/projects/${nextProject.slug}/`)}><span class="small-label">{study ? "Next case study" : "Next project"}</span><strong>{nextProject.title} <Icon name="arrow-up-right" /></strong></a>}
    </nav>
  </div>
  <script>
    function revealDocumentationAnchor() {
      if (!location.hash) return;
      let id: string;
      try {
        id = decodeURIComponent(location.hash.slice(1));
      } catch (error) {
        if (error instanceof URIError) {
          console.warn("The document link contains an invalid fragment encoding.");
          return;
        }
        throw error;
      }
      const target = document.getElementById(id);
      if (!target) return;
      let opened = false;
      for (let parent = target.parentElement; parent; parent = parent.parentElement) {
        if (parent instanceof HTMLDetailsElement && !parent.open) {
          parent.open = true;
          opened = true;
        }
      }
      if (opened) requestAnimationFrame(() => target.scrollIntoView());
    }
    revealDocumentationAnchor();
    window.addEventListener("hashchange", revealDocumentationAnchor);
  </script>
</BaseLayout>

<style>
  .project-hero { padding-bottom: 26px; }
  .project-hero h1 { max-width: 1080px; }
  .project-hero h1 > span, .project-hero h1 em { display: block; }
  .project-hero h1 em { font-family: var(--sans); font-style: normal; font-weight: 600; color: var(--blue); }
  .project-hero .lead { max-width: 890px; }
  .project-hero .eyebrow { font-size: 10px; }
  .project-scope { font-size: 13px; color: var(--muted); line-height: 1.85; max-width: 1080px; }
  .project-scope strong { color: var(--ink); }
  .case-art-stage { background: #dce8df; border: 1px solid #cddbcc; border-radius: 4px; padding: 25px; }
  .case-art-stage picture { display: block; max-width: 920px; margin-inline: auto; }
  .case-art-stage img { width: 100%; height: 390px; object-fit: contain; }
  .case-art-stage.theme-retrieval { background: #e5eaff; border-color: #d5ddf6; }
  .case-art-stage.theme-observability { background: #172a24; border-color: #172a24; }
  .case-hero-visual figcaption { max-width: 980px; margin-top: 15px; color: var(--muted); font: 10px/1.9 var(--mono); }
  .reference-layout { display: grid; grid-template-columns: 215px minmax(0, 1fr); gap: 60px; padding-top: 15px; padding-bottom: 60px; }
  .reference-main { min-width: 0; }
  .reference-sidebar nav { position: sticky; top: 115px; max-height: calc(100dvh - 140px); overflow-y: auto; }
  .reference-sidebar nav > a { display: block; border-bottom: 1px solid var(--line); padding: 10px 3px 10px 0; font-size: 11px; line-height: 1.7; overflow-wrap: anywhere; }
  .readme-introduction { border: 1px solid var(--line); border-left: 3px solid var(--blue); padding: 25px; margin-bottom: 38px; }
  .readme-introduction > .eyebrow { color: var(--blue); font-size: 10px; }
  .readme-introduction > p:not(.eyebrow) { color: var(--muted); font-size: 14px; line-height: 1.85; }
  .readme-introduction .text-link { font-size: 12px; }
  .supporting-documents { margin-top: 50px; padding-top: 35px; border-top: 1px solid var(--line); scroll-margin-top: 110px; }
  .supporting-documents h2 { font-size: 33px; }
  .supporting-documents > p.muted { font-size: 14px; }
  .project-pagination { display: grid; grid-template-columns: 1fr 1fr; gap: 55px; padding: 32px 0 53px; border-top: 1px solid var(--line); }
  .project-pagination > a { display: grid; align-content: start; gap: 12px; }
  .project-pagination > a:last-child { text-align: right; }
  .project-pagination strong { display: flex; justify-content: space-between; align-items: center; gap: 25px; font-size: 20px; line-height: 1.4; font-weight: 600; }
  .project-pagination :global(svg) { flex-shrink: 0; }
  @media (max-width: 1000px) {
    .reference-layout { grid-template-columns: 175px minmax(0, 1fr); gap: 35px; }
    .case-art-stage img { height: 315px; }
  }
  @media (max-width: 700px) {
    .project-hero .eyebrow { font-size: 9px; }
    .project-hero h1 { font-size: clamp(39px, 10vw, 55px); overflow-wrap: anywhere; }
    .project-hero .button { font-size: 12px; padding-inline: 15px; gap: 12px; }
    .case-art-stage { padding: 18px 10px; }
    .case-art-stage img { height: 270px; }
    .case-art-stage.theme-retrieval img { height: 340px; }
    .case-hero-visual figcaption { font-size: 9px; }
    .reference-layout { grid-template-columns: minmax(0, 1fr); gap: 30px; padding-bottom: 40px; }
    .reference-sidebar nav { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; max-height: none; }
    .reference-sidebar nav > p { grid-column: 1 / -1; }
    .reference-sidebar nav > a { font-size: 10px; }
    .readme-introduction { padding: 22px; }
    .project-pagination { grid-template-columns: 1fr; gap: 30px; padding-bottom: 38px; }
    .project-pagination > a:last-child { text-align: left; }
    .project-pagination strong { font-size: 21px; }
  }
  @media print {
    .reference-layout { display: block; }
    .reference-sidebar, .project-pagination { display: none; }
  }
</style>
