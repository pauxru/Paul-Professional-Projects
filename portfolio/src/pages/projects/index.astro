---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { projects, tracks } from "../../data/projects";
import { pathTo } from "../../lib/urls";
import { projectSearchText } from "../../lib/filters";
const languages = [...new Set(projects.flatMap((project) => project.languages))].sort((a, b) => a.localeCompare(b));
const documents = projects.reduce((sum, project) => sum + project.documentationCount, 0);
const decisions = projects.reduce((sum, project) => sum + project.decisionRecordCount, 0);
---
<BaseLayout title="Engineering projects" description="Explore 50 independent engineering projects across distributed systems, .NET and Azure modernization, and AI applications. Search by technology, track or engineering concern." breadcrumbs={[{ name: "Home", path: "/" }, { name: "Projects", path: "/projects/" }]}>
  <section class="wrap page-hero library-hero">
    <p class="eyebrow">The engineering library</p>
    <h1>Explore the work.<br /><span class="blue">Follow the reasoning.</span></h1>
    <p class="lead">Fifty independent projects spanning systems engineering, modernization and AI applications. Each has its own implementation, documentation and explicit scope. Three include a curated, in-depth case study.</p>
    <div class="library-facts">
      <div><strong>{projects.length}</strong><span>Documented projects</span></div>
      <div><strong>{tracks.length}</strong><span>Engineering tracks</span></div>
      <div><strong>{documents}</strong><span>Supporting documents</span></div>
      <div><strong>{decisions}</strong><span>Decision records</span></div>
    </div>
  </section>

  <section class="wrap library" aria-label="Browse projects">
    <form class="project-filters" data-project-filters role="search" aria-label="Filter the project library" hidden>
      <div class="search-field">
        <label for="project-search">Search projects</label>
        <div class="search-input"><Icon name="search" size={19} /><input id="project-search" name="q" type="search" placeholder="Title, language or engineering concern" autocomplete="off" /></div>
      </div>
      <div><label for="track-filter">Engineering track</label><select id="track-filter" name="track"><option value="">All tracks</option>{tracks.map((item) => <option value={item.id}>{item.label}</option>)}</select></div>
      <div><label for="language-filter">Language</label><select id="language-filter" name="language"><option value="">All languages</option>{languages.map((item) => <option value={item}>{item}</option>)}</select></div>
      <button type="button" class="filter-reset" data-clear-filters>Clear filters</button>
    </form>
    <noscript><p class="callout">All 50 projects are available below without JavaScript. Use the track links or your browser's Find command to locate a project. Live filters require JavaScript.</p></noscript>
    <p class="filter-warning" data-filter-warning role="status" hidden></p>
    <div class="library-toolbar">
      <p data-results-count role="status" aria-live="polite" aria-atomic="true">{projects.length} of {projects.length} projects</p>
      <nav aria-label="Jump to an engineering track">{tracks.map((item) => <a href={`#${item.id}`} data-track-jump={item.id}>{item.label}</a>)}</nav>
    </div>
    <div class="empty-state" data-empty-state hidden>
      <span class="eyebrow">No matching projects</span><h2>Try a different starting point.</h2><p>Use a broader term, choose another language or clear the filters to see the full library.</p><button type="button" class="button secondary" data-clear-filters>Show all projects <Icon name="arrow-right" /></button>
    </div>
    {tracks.map((item, index) => (
      <section class="library-track" id={item.id} data-track-group aria-labelledby={`heading-${item.id}`}>
        <header class="track-heading"><div><span class="eyebrow">Track 0{index + 1}</span><h2 id={`heading-${item.id}`}>{item.label}</h2><p>{item.description}</p></div><span class="small-label" data-track-count>{projects.filter((project) => project.track === item.id).length} projects</span></header>
        <div class="project-grid">
          {projects.filter((project) => project.track === item.id).map((project) => (
            <article class="library-card" data-project-number={project.number} data-track={project.track} data-search={projectSearchText(project)} data-languages={JSON.stringify(project.languages)}>
              <div class="library-card-top"><img src={pathTo(`/project-icons/${String(project.number).padStart(2, "0")}.svg`)} width="54" height="54" alt="" loading="lazy" decoding="async" /><span class:list={["small-label", { "deep-dive-label": project.featured }]}>{project.featured ? "In-depth case study" : "Independent project"}</span></div>
              <h3><a href={pathTo(`/projects/${project.slug}/`)}>{project.title}</a></h3>
              <p>{project.summary}</p>
              <div class="tag-row">{project.languages.map((language) => <span class="tag">{language}</span>)}</div>
              <a class="library-project-link" href={pathTo(`/projects/${project.slug}/`)}>Explore project <Icon name="arrow-up-right" size={18} /><span class="sr-only">: {project.title}</span></a>
              <div class="library-document-links"><a class="readme-link" href={project.readmeUrl}>README<span class="sr-only"> for {project.title}</span></a><a class="design-docs-link" href={project.docsUrl}>Design docs<span class="sr-only"> for {project.title}</span></a><span>{project.decisionRecordCount} ADRs</span></div>
            </article>
          ))}
        </div>
      </section>
    ))}
    <aside class="library-scope callout"><strong>How to read this portfolio.</strong> These are self-directed implementations and controlled engineering studies, not claims of customer deployment. Results are bounded by the environment and evaluation described in each project. Professional roles and cross-team responsibilities are documented separately in <a href={pathTo("/experience/")}>Experience</a> and <a href={pathTo("/leadership/")}>Leadership</a>.</aside>
  </section>
  <script>import "../../scripts/project-filters";</script>
</BaseLayout>

<style>
  .library-hero { padding-bottom: 35px; }
  .library-hero .lead { max-width: 830px; }
  .library-facts { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 38px; border-block: 1px solid var(--line); padding: 23px 0; }
  .library-facts > div { display: flex; align-items: center; gap: 15px; }
  .library-facts strong { font-size: 35px; letter-spacing: -.04em; font-weight: 500; line-height: 1.2; color: var(--blue); }
  .library-facts span { font: 10px/1.6 var(--mono); max-width: 115px; color: var(--muted); }
  .library { padding-bottom: 70px; }
  .project-filters { display: grid; grid-template-columns: minmax(240px, 1.6fr) minmax(190px, 1fr) minmax(145px, .7fr) auto; align-items: end; gap: 18px; padding: 24px; border: 1px solid var(--line); background: var(--sage); border-radius: 4px; }
  .project-filters label { display: block; margin-bottom: 8px; font-size: 11px; font-weight: 600; }
  .project-filters input, .project-filters select { width: 100%; min-width: 0; height: 47px; color: var(--ink); background: #fbfcf8; border: 1px solid #748576; border-radius: 3px; font-size: 13px; padding: 10px 12px; }
  .project-filters input { padding-left: 40px; }
  .search-input { position: relative; }
  .search-input :global(svg) { position: absolute; top: 14px; left: 12px; color: var(--muted); pointer-events: none; }
  .filter-reset { height: 47px; padding: 10px 7px; border: 0; color: #2143b0; background: none; font-size: 12px; text-decoration: underline; text-underline-offset: 3px; }
  .library-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 25px; padding: 23px 0; }
  .library-toolbar > p { flex-shrink: 0; margin: 0; font: 11px/1.8 var(--mono); color: var(--muted); }
  .library-toolbar nav { display: flex; flex-wrap: wrap; justify-content: end; gap: 12px 20px; font-size: 11px; }
  .library-toolbar nav a { text-decoration: underline; }
  .filter-warning { margin-top: 18px; padding: 14px 18px; border: 1px solid #b2a46a; background: #f1edda; font-size: 14px; }
  .track-heading { display: flex; justify-content: space-between; align-items: end; gap: 25px; margin: 36px 0 27px; border-top: 1px solid var(--line); padding-top: 32px; }
  .track-heading h2 { font-size: 32px; margin-bottom: 13px; }
  .track-heading .eyebrow { color: var(--blue); display: block; margin-bottom: 11px; }
  .track-heading p { max-width: 790px; color: var(--muted); font-size: 14px; margin-bottom: 0; }
  .track-heading > .small-label { flex-shrink: 0; }
  .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .library-card { display: flex; flex-direction: column; min-width: 0; padding: 25px; border: 1px solid var(--line); border-radius: 4px; background: #f9faf5; transition: border-color .2s ease, box-shadow .2s ease; }
  .library-card:hover { border-color: #9bb1a0; box-shadow: 0 8px 25px rgb(29 59 37 / 5%); }
  .library-card-top { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 22px; }
  .library-card-top img { width: 54px; height: 54px; flex-shrink: 0; }
  .library-card-top > span { font-size: 9px; text-align: right; }
  .library-card-top .deep-dive-label { color: #1d43bd; }
  .library-card h3 { font-size: 22px; line-height: 1.23; margin-bottom: 16px; text-wrap: pretty; }
  .library-card > p { font-size: 13px; line-height: 1.85; color: var(--muted); }
  .library-card .tag-row { margin-top: auto; padding-top: 4px; }
  .library-project-link { display: flex; align-items: center; justify-content: space-between; gap: 15px; border-top: 1px solid var(--line); padding-top: 17px; margin-top: 22px; font-size: 12px; font-weight: 600; }
  .library-document-links { display: flex; flex-wrap: wrap; align-items: center; gap: 9px 15px; margin-top: 16px; font-size: 10px; color: var(--muted); }
  .library-document-links a { text-decoration: underline; }
  .library-document-links > span { margin-left: auto; font: 9px/1.7 var(--mono); }
  .library-scope { margin-top: 45px; font-size: 14px; line-height: 1.85; }
  .library-scope a { color: #1d43bd; text-decoration: underline; }
  .empty-state { text-align: center; padding: 80px 24px; border: 1px solid var(--line); margin-top: 20px; }
  .empty-state .eyebrow { color: var(--blue); }
  .empty-state h2 { font-size: 36px; }
  .empty-state p { max-width: 500px; margin: 0 auto 28px; color: var(--muted); }
  @media (max-width: 1100px) {
    .project-filters { grid-template-columns: 1.3fr 1fr; }
    .filter-reset { justify-self: start; }
    .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .library-facts > div { flex-direction: column; align-items: start; gap: 6px; }
    .library-facts span { max-width: none; }
  }
  @media (max-width: 700px) {
    .library-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-block: 22px; margin-top: 26px; }
    .library-facts > div { flex-direction: row; align-items: center; gap: 12px; }
    .library-facts strong { font-size: 29px; }
    .library-facts span { font-size: 9px; max-width: 95px; }
    .project-filters { grid-template-columns: 1fr 1fr; gap: 16px; padding: 18px; }
    .project-filters .search-field { grid-column: 1 / -1; }
    .project-filters label { font-size: 10px; }
    .project-filters select { font-size: 11px; padding-inline: 7px; }
    .project-filters input { font-size: 12px; }
    .filter-reset { height: 32px; padding-block: 0; }
    .library-toolbar { align-items: start; flex-direction: column; gap: 15px; }
    .library-toolbar nav { justify-content: start; font-size: 10px; }
    .track-heading { align-items: start; flex-direction: column; gap: 16px; margin-top: 25px; }
    .track-heading h2 { font-size: 30px; }
    .project-grid { grid-template-columns: 1fr; gap: 18px; }
    .library-card { padding: 25px; }
    .library-card h3 { font-size: 25px; }
    .library-card > p { font-size: 14px; }
    .library-scope { margin-top: 32px; }
  }
</style>
