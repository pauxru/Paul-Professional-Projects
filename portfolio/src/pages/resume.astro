---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import profile from "../data/profile.json";
import { absoluteUrl, pathTo } from "../lib/urls";

const site = Astro.site;
if (!site) throw new Error("A configured Astro site is required for the resume page.");
const homeUrl = absoluteUrl("/", site);
---
<BaseLayout
  title="Resume"
  description="A concise, print-friendly resume for Paul Rukwaro, Senior Software Engineer: professional experience, toolkit and education, downloadable as PDF or printable directly from the browser."
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Resume", path: "/resume/" }]}
>
  <section class="wrap page-hero resume-hero no-print">
    <p class="eyebrow">Career materials</p>
    <h1>Resume</h1>
    <p class="lead">Professional experience, technical responsibilities and education in a format built for career conversations. Download the concise PDF for sharing, or print the expanded resume below.</p>
    <div class="button-row">
      <a class="button" href={pathTo("/resume/Paul-Rukwaro-Resume.pdf")} download>Download PDF <Icon name="download" /></a>
      <button type="button" class="button secondary" data-print-button>Print this page</button>
    </div>
  </section>

  <section class="wrap section-tight resume-wrap">
    <div class="resume-sheet">
      <header class="resume-header">
        <h2>{profile.name}</h2>
        <p class="resume-title">{profile.title} &middot; {profile.specialization}</p>
        <p class="resume-contact-line">
          {profile.location}
          <span aria-hidden="true"> &middot; </span>
          <a href={profile.linkedin}>LinkedIn</a>
          <span aria-hidden="true"> &middot; </span>
          <a href={profile.github}>GitHub</a>
        </p>
      </header>

      <section class="resume-section" aria-labelledby="resume-summary">
        <h2 id="resume-summary">Summary</h2>
        <p>{profile.summary}</p>
      </section>

      <section class="resume-section" aria-labelledby="resume-experience">
        <h2 id="resume-experience">Experience</h2>
        <div class="resume-jobs">
          {profile.experience.map((job) => (
            <article class="resume-job">
              <div class="resume-job-head">
                <h3>{job.company} &mdash; {job.role}</h3>
                <p class="resume-job-dates">{job.start} &ndash; {job.end}</p>
              </div>
              <p class="resume-job-context muted">{job.context}</p>
              <p>{job.summary}</p>
              <ul class="detail-list">{job.responsibilities.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </section>

      <section class="resume-section" aria-labelledby="resume-education">
        <h2 id="resume-education">Education</h2>
        <ul class="detail-list">
          {profile.education.map((entry) => (
            <li><strong>{entry.qualification}</strong>, {entry.institution} &middot; {entry.dates} &middot; {entry.status}</li>
          ))}
        </ul>
      </section>

      <section class="resume-section" aria-labelledby="resume-skills">
        <h2 id="resume-skills">Skills</h2>
        <dl class="fact-grid resume-skills-grid">
          {profile.skills.map((group) => (
            <div><dt>{group.area}</dt><dd>{group.items.join(", ")}</dd></div>
          ))}
        </dl>
      </section>

      <section class="resume-section" aria-labelledby="resume-credentials">
        <h2 id="resume-credentials">Prior credentials</h2>
        <ul class="detail-list">
          {profile.priorCredentials.map((entry) => (
            <li>{entry.name} &middot; {entry.issuer} &middot; {entry.earned}.{entry.note && <> <span class="muted">{entry.note}</span></>}</li>
          ))}
        </ul>
      </section>

      <p class="print-only resume-print-footer">{profile.name} &middot; {profile.linkedin.replace("https://", "")} &middot; Full portfolio: {homeUrl.replace("https://", "")}</p>
    </div>
  </section>
</BaseLayout>

<script>
  const printButton = document.querySelector<HTMLButtonElement>("[data-print-button]");
  printButton?.addEventListener("click", () => window.print());
</script>

<style>
  .resume-hero { padding-bottom: 26px; }
  .resume-hero .lead { max-width: 720px; }
  .resume-wrap { padding-bottom: 70px; }
  .resume-header h2 { font-size: 34px; margin-bottom: 8px; letter-spacing: -.03em; }
  .resume-title { font-size: 15px; color: var(--muted); margin-bottom: 8px; }
  .resume-contact-line { font-size: 13px; color: var(--muted); margin: 0; }
  .resume-contact-line a { color: #1d43bd; text-decoration: underline; text-underline-offset: 2px; overflow-wrap: anywhere; }
  .resume-section h2 { font-size: 21px; margin-bottom: 14px; }
  .resume-jobs { display: grid; gap: 26px; }
  .resume-job { padding-top: 22px; border-top: 1px solid var(--line); }
  .resume-job:first-child { padding-top: 0; border-top: 0; }
  .resume-job-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; }
  .resume-job-head h3 { font-size: 18px; margin: 0; }
  .resume-job-dates { font: 11px/1.6 var(--mono); color: var(--muted); margin: 0; white-space: nowrap; }
  .resume-job-context { font-size: 12px; margin: 4px 0 10px; }
  .resume-job p:not(.resume-job-context) { font-size: 14px; margin-bottom: 10px; }
  .resume-job .detail-list { font-size: 13px; margin: 0; }
  .resume-skills-grid dt { font-size: 12px; font-weight: 600; color: var(--ink); margin-bottom: 6px; }
  .resume-skills-grid dd { font-size: 13px; color: var(--muted); line-height: 1.7; }
  .resume-section li { font-size: 14px; }
  .print-only { display: none; }
  @page { size: A4; margin: 14mm 15mm; }
  @media (max-width: 700px) {
    .resume-header h2 { font-size: 28px; }
    .resume-job-head { flex-direction: column; align-items: start; gap: 2px; }
  }
  @media print {
    .resume-wrap { padding-bottom: 0; }
    .resume-header { padding-bottom: 12px; }
    .resume-header h2 { font-size: 22pt; }
    .resume-title, .resume-contact-line { font-size: 9.5pt; }
    .resume-section { break-inside: auto; margin-top: 16px; }
    .resume-section h2 { font-size: 12pt; margin-bottom: 8px; }
    .resume-section p, .resume-section li, .resume-job p:not(.resume-job-context) { font-size: 9.5pt; line-height: 1.45; }
    .resume-jobs { display: block; }
    .resume-job { break-inside: avoid; padding-top: 10px; margin-top: 12px; }
    .resume-job-head h3 { font-size: 10.5pt; }
    .resume-job .detail-list li { margin-bottom: 4px; }
    .resume-job-context { margin-bottom: 6px; }
    .resume-skills-grid { display: block; margin-block: 12px; }
    .resume-skills-grid > div { display: grid; grid-template-columns: 40mm 1fr; gap: 10px; padding: 6px 0; }
    .resume-skills-grid dt, .resume-skills-grid dd { font-size: 9.5pt; line-height: 1.45; }
    .print-only.resume-print-footer { display: block; margin-top: 15px; padding-top: 10px; border-top: 1px solid #ccc; font: 8pt/1.5 var(--mono); color: #444; overflow-wrap: anywhere; }
  }
</style>
