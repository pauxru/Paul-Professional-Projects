# Copy to .env for local development. .env is gitignored.

# API host / port
ASPNETCORE_URLS=http://localhost:5001
ASPNETCORE_ENVIRONMENT=Development

# Database adapter selection.  Provider = Sqlite | Postgres
Database__Provider=Sqlite
Database__ConnectionString=Data Source=contoso-payments.db

# Messaging adapter selection.  Provider = InMemory | RabbitMq | AzureServiceBus
Messaging__Provider=InMemory
Messaging__RabbitMq__Host=localhost
Messaging__RabbitMq__User=guest
Messaging__RabbitMq__Password=change-me
Messaging__AzureServiceBus__ConnectionString=Endpoint=sb://example.servicebus.windows.net/;...

# Cache adapter selection.  Provider = Memory | Redis
Cache__Provider=Memory
Cache__Redis__ConnectionString=localhost:6379

# JWT signing.  Do NOT reuse this key in production; startup guard refuses default in Production.
Jwt__Issuer=https://contoso-payments.local
Jwt__Audience=contoso-payments-api
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789ABCDEF

# Payment provider simulator config
PaymentProvider__Mode=Deterministic
PaymentProvider__WebhookSigningSecret=dev-only-webhook-secret-change-me-0123456789ABCDEF
PaymentProvider__WebhookTimestampToleranceSeconds=300

# Outbox dispatcher
Outbox__PollIntervalMilliseconds=250
Outbox__MaxAttempts=5
Outbox__BaseBackoffMilliseconds=100
