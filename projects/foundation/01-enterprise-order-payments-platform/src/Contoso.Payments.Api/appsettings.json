{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=contoso-payments.db"
  },
  "Messaging": { "Provider": "InMemory" },
  "Cache": { "Provider": "Memory" },
  "Jwt": {
    "Issuer": "https://contoso-payments.local",
    "Audience": "contoso-payments-api",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789ABCDEF"
  },
  "PaymentProvider": {
    "Mode": "Deterministic",
    "WebhookSigningSecret": "dev-only-webhook-secret-change-me-0123456789ABCDEF",
    "WebhookTimestampToleranceSeconds": 300,
    "TimeoutInjectionPercent": 0,
    "DeclineInjectionPercent": 0,
    "SimulatedLatencyMs": 5,
    "AsynchronousCaptureMode": false
  },
  "Outbox": {
    "PollIntervalMilliseconds": 250,
    "MaxAttempts": 5,
    "BaseBackoffMilliseconds": 100,
    "BatchSize": 32
  }
}
