{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=northstar-modern.db"
  },
  "DocumentStore": {
    "Provider": "LocalFileSystem",
    "RootPath": "App_Data/documents",
    "MaxBytes": 5242880
  },
  "LegacyImport": {
    "ConnectionString": "Data Source=../../../legacy/Northstar.Legacy.Web/legacy-northstar.db"
  },
  "Jwt": {
    "Issuer": "northstar-modernization",
    "Audience": "northstar-claims-api",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789"
  },
  "OpenTelemetry": {
    "Exporter": "Console"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
