# -----------------------------------------------------------------------------
# Enterprise RAG Knowledge Assistant — environment template
#
# Copy to .env and fill values for a real deployment. The defaults below are
# safe for local dev and CI and NEVER work in Production (the API refuses to
# boot with the dev signing key when ASPNETCORE_ENVIRONMENT=Production).
# -----------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Development

# --- Kestrel ---------------------------------------------------------------
Kestrel__Endpoints__Http__Url=http://localhost:5003

# --- Database (default: SQLite, no server) ---------------------------------
Database__Provider=Sqlite
Database__ConnectionString=Data Source=rag.db

# --- JWT authentication ----------------------------------------------------
Jwt__Issuer=rag-assistant-dev
Jwt__Audience=rag-assistant-dev-clients
# 32+ char HS256 secret. Replace in Production.
Jwt__SigningKey=dev-only-signing-key-please-rotate-0123456789

# --- Rate limiting ---------------------------------------------------------
RateLimiting__PermitsPerMinute=120

# --- Budget guard ----------------------------------------------------------
Budget__DailyLimitUsd=25.00
Budget__DailyRequestLimit=5000

# --- AI provider -----------------------------------------------------------
# Local (default) — deterministic, no network.
Ai__Provider=Local
Ai__EmbeddingDimensions=384

# Uncomment for OpenAI. Do not commit real keys.
# Ai__Provider=OpenAI
# Ai__OpenAi__ApiKey=REPLACE_ME
# Ai__OpenAi__ChatModel=gpt-4o-mini
# Ai__OpenAi__EmbeddingModel=text-embedding-3-small

# Uncomment for Azure OpenAI.
# Ai__Provider=AzureOpenAI
# Ai__Azure__Endpoint=https://your-aoai.openai.azure.com
# Ai__Azure__ApiKey=REPLACE_ME
# Ai__Azure__ChatDeployment=gpt-4o-mini
# Ai__Azure__EmbeddingDeployment=text-embedding-3-small

# --- RAG behaviour ---------------------------------------------------------
Rag__MinRetrievalScore=0.05
Rag__MinSupportForSentence=0.25
Rag__MinSupportRatio=0.4
Rag__TopK=4
