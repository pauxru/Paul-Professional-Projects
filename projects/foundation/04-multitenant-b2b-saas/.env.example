# Development-only examples. Never use these values in production.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5004
Database__Provider=Sqlite
Database__ConnectionString=Data Source=fieldops.db
Jwt__Issuer=fieldops-dev
Jwt__Audience=fieldops-api
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
TenantResolution__HeaderName=X-Tenant
TenantResolution__BaseDomain=fieldops.local
Billing__WebhookSecret=dev-only-webhook-secret-change-me
Billing__SignatureToleranceMinutes=5
Billing__SuspendAfterFailures=3
ObjectStore__RootPath=App_Data\objects
