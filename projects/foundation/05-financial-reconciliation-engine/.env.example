# ---------------------------------------------------------------------------
# Example environment configuration for the Financial Reconciliation Engine.
# Copy to `.env` (gitignored) and adjust. Values here mirror appsettings.json.
# NONE of these are real secrets — replace the JWT key before any real use.
# ---------------------------------------------------------------------------

# ASP.NET Core host + environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5005

# Database (SQLite is the default; swap to Npgsql for Postgres in Infrastructure)
ConnectionStrings__Default=Data Source=recon.db

# JWT authentication (HMAC-SHA256). The key MUST be at least 32 characters.
# In Production the app should refuse to start with a default/placeholder key.
Jwt__Issuer=recon-engine
Jwt__Audience=recon-engine-clients
Jwt__Key=dev-only-not-a-real-secret-change-me-0123456789
Jwt__AccessTokenMinutes=60

# Reconciliation policy
# WriteOffApprovalThresholdMinor: write-offs at/above this (minor units) need four-eyes approval.
#   100000 minor = 1000.00 in a 2-decimal currency.
# HighSeverityAmountMinor: exceptions at/above this amount are escalated in severity.
Reconciliation__WriteOffApprovalThresholdMinor=100000
Reconciliation__DefaultRuleSetName=default
Reconciliation__HighSeverityAmountMinor=50000

# Rate limiting (fixed window, per client IP)
RateLimiting__PermitPerWindow=100
RateLimiting__WindowSeconds=10
RateLimiting__QueueLimit=0
