{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=recon.db"
  },
  "Jwt": {
    "Issuer": "recon-engine",
    "Audience": "recon-engine-clients",
    "Key": "REPLACE_THIS_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 60
  },
  "Reconciliation": {
    "WriteOffApprovalThresholdMinor": 100000,
    "DefaultRuleSetName": "default",
    "HighSeverityAmountMinor": 50000
  },
  "RateLimiting": {
    "PermitPerWindow": 100,
    "WindowSeconds": 10,
    "QueueLimit": 0
  }
}
