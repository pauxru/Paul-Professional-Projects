# -----------------------------------------------------------------------------
# Zero-Trust API Platform — example environment
# Copy to `.env` and edit locally. `.env` is gitignored — do NOT commit real
# secrets here. Every value below is a demo/dev placeholder.
# -----------------------------------------------------------------------------

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5007

# Database (default SQLite; swap for Postgres/SQL Server in production)
Database__Provider=Sqlite
Database__ConnectionString=Data Source=zero-trust.db

# JWT / trust-core configuration
# UseRs256=true means the /.well-known/jwks.json endpoint is authoritative.
# UseRs256=false switches to HS256 for isolated demos only.
Jwt__UseRs256=true
Jwt__Issuer=https://zero-trust-demo.localhost
Jwt__DefaultAudience=ntsf-customer-api
Jwt__AccessTokenMinutes=15
Jwt__AdminAccessTokenMinutes=5
Jwt__RefreshTokenDays=14
Jwt__RequiredAcr=urn:ntsf:acr:step-up

# Only used when UseRs256=false. Refuse to boot in Production with this value.
Jwt__HsSigningKey=dev-only-not-a-real-secret-change-me-0123456789

# Rate limiter (defaults; per-partner values are stored in the DB)
RateLimiting__PartnerPermitsPerMinute=60
RateLimiting__AdminPermitsPerMinute=30
RateLimiting__UserPermitsPerMinute=120
RateLimiting__PublicPermitsPerMinute=30

# CORS
Cors__AllowedOrigins__0=https://localhost:5007
