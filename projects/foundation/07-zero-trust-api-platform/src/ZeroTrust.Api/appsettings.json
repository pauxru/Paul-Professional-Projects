{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=zero-trust.db"
  },
  "Jwt": {
    "Issuer": "https://zero-trust-demo.localhost",
    "AccessTokenMinutes": 15,
    "AdminAccessTokenMinutes": 5,
    "RefreshTokenDays": 14,
    "UseRs256": true,
    "DefaultAudience": "ntsf-customer-api",
    "RequireStepUpForAdmin": true,
    "RequiredAmr": "mfa",
    "RequiredAcr": "urn:ntsf:acr:step-up",
    "HsSigningKey": "dev-only-not-a-real-secret-change-me-0123456789"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5007", "https://localhost:5007" ]
  },
  "RateLimiting": {
    "PartnerPermitsPerMinute": 60,
    "AdminPermitsPerMinute": 30,
    "UserPermitsPerMinute": 120,
    "PublicPermitsPerMinute": 30
  }
}
