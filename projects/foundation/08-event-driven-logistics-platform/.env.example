# Development-only examples. Do not use these values in production.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5008
Database__Provider=Sqlite
Database__ConnectionString=Data Source=savanna-logistics.db;Default Timeout=10;Cache=Shared
Messaging__Provider=InMemory
Cache__Provider=Memory
Jwt__Issuer=SavannaLogistics
Jwt__Audience=SavannaLogistics.Api
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
Telemetry__Partitions=4
Telemetry__AllowedLatenessSeconds=5
Telemetry__ChannelCapacityPerPartition=2048
Alerts__SuppressionWindowSeconds=120
Eta__TrafficFactor=1.25
Observability__ConsoleExporter=false
