{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=savanna-logistics.db;Default Timeout=10;Cache=Shared"
  },
  "Messaging": {
    "Provider": "InMemory"
  },
  "Cache": {
    "Provider": "Memory"
  },
  "Jwt": {
    "Issuer": "SavannaLogistics",
    "Audience": "SavannaLogistics.Api",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789"
  },
  "Telemetry": {
    "Partitions": 4,
    "ChannelCapacityPerPartition": 2048,
    "AllowedLatenessSeconds": 5,
    "DedupCacheCapacity": 100000,
    "DedupExpirySeconds": 900,
    "OfflineAfterSeconds": 120
  },
  "Alerts": {
    "SpeedLimitKph": 80,
    "HarshBrakingDeltaKph": 25,
    "RouteCorridorKm": 0.5,
    "ProlongedStopSeconds": 300,
    "SuppressionWindowSeconds": 120,
    "GeofenceEnterDwellSeconds": 10,
    "GeofenceExitDwellSeconds": 10
  },
  "Eta": {
    "RollingSpeedSamples": 8,
    "MinimumEffectiveSpeedKph": 12,
    "TrafficFactor": 1.25,
    "DefaultDwellMinutes": 4
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3008", "http://localhost:5008" ]
  },
  "Observability": {
    "ConsoleExporter": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
