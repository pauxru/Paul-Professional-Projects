# .env.example — Intelligent Document Processing Platform
# Copy to .env for local overrides. NO REAL SECRETS. Values map to appsettings.json via the
# ASP.NET Core configuration provider (nested keys use double underscores).

# ---- Host ----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5009

# ---- Seeding (Development/Testing seed the synthetic corpus; keep false in Production) ----
Seed=false

# ---- Database (SQLite by default; Provider=Postgres + a Npgsql connection string for Postgres) ----
Database__Provider=Sqlite
Database__ConnectionString=Data Source=idp.db

# ---- Object storage (local filesystem adapter; kept OUTSIDE any web root) ----
Storage__Provider=FileSystem
Storage__RootPath=artifacts/object-store

# ---- Ingestion / upload limits ----
Ingestion__MaxUploadBytes=5242880
Ingestion__DropFolderEnabled=false
Ingestion__DropFolderPath=artifacts/drop

# ---- Classifier (Rules = deterministic default; Llm = optional adapter, needs IChatModel wired) ----
Classifier__Provider=Rules

# ---- Pipeline routing thresholds ----
Pipeline__AutoApproveThreshold=0.85
Pipeline__RejectThreshold=0.30
Pipeline__AutoExportOnApprove=true

# ---- Validation tolerances ----
Validation__ArithmeticAbsoluteTolerance=0.02
Validation__ArithmeticRelativeTolerance=0.01
Validation__QuantityVariancePercent=0.05
Validation__PriceVariancePercent=0.05
Validation__SupplierMatchThreshold=0.86

# ---- Review queue ----
Review__ClaimLeaseMinutes=30
Review__SlaHours=24

# ---- Export ----
Export__MaxAttempts=3
Export__Format=Json
Export__OutboxPath=artifacts/outbox
Export__DeadLetterPath=artifacts/deadletter
Export__SimulatedFailureRate=0.0
Export__ErpEndpoint=http://localhost:5009/simulated-erp/invoices

# ---- JWT (DEV-ONLY placeholder; the app refuses to start in Production with this default key) ----
Jwt__Issuer=idp-dev
Jwt__Audience=idp-api
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
