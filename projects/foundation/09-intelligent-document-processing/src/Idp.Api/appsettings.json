{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seed": false,
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=idp.db"
  },
  "Storage": {
    "Provider": "FileSystem",
    "RootPath": "artifacts/object-store"
  },
  "Ingestion": {
    "MaxUploadBytes": 5242880,
    "DropFolderEnabled": false,
    "DropFolderPath": "artifacts/drop",
    "AllowedContentTypes": [
      "text/plain",
      "text/csv",
      "application/json",
      "application/vnd.idp.ocr+json",
      "application/octet-stream"
    ],
    "AllowedExtensions": [ ".txt", ".csv", ".json", ".ocr.json" ]
  },
  "Classifier": {
    "Provider": "Rules"
  },
  "Pipeline": {
    "AutoApproveThreshold": 0.85,
    "RejectThreshold": 0.30,
    "AutoExportOnApprove": true
  },
  "Validation": {
    "ArithmeticAbsoluteTolerance": 0.02,
    "ArithmeticRelativeTolerance": 0.01,
    "QuantityVariancePercent": 0.05,
    "PriceVariancePercent": 0.05,
    "SupplierMatchThreshold": 0.86
  },
  "Review": {
    "ClaimLeaseMinutes": 30,
    "SlaHours": 24
  },
  "Export": {
    "MaxAttempts": 3,
    "Format": "Json",
    "OutboxPath": "artifacts/outbox",
    "DeadLetterPath": "artifacts/deadletter",
    "SimulatedFailureRate": 0.0,
    "ErpEndpoint": "http://localhost:5009/simulated-erp/invoices"
  },
  "Jwt": {
    "Issuer": "idp-dev",
    "Audience": "idp-api",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789"
  }
}
