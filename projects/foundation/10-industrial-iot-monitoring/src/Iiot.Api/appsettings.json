{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=iiot.db"
  },
  "Messaging": {
    "Provider": "InProcessMqtt",
    "BrokerPort": 18830
  },
  "Cache": {
    "Provider": "Memory"
  },
  "Ai": {
    "Provider": "ExplainableStatistics"
  },
  "Jwt": {
    "Issuer": "industrial-iot-monitoring",
    "Audience": "industrial-iot-dashboard",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost"
}
