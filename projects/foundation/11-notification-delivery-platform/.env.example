# Copy to .env for local development. Never commit .env.
# Overrides that map to appsettings.json can also be supplied as
# ASPNETCORE_* environment variables in the form Section__Key.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5011

# JWT signing key. Production refuses to boot if this starts with "dev-only-".
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
Jwt__Issuer=notification-platform
Jwt__Audience=notification-platform

# Webhook HMAC signing key.  Same production guard applies.
Webhook__SigningKey=dev-only-webhook-signing-secret-please-change-0123456789
Webhook__SignatureHeader=X-Signature
Webhook__TimestampHeader=X-Timestamp
Webhook__NonceHeader=X-Nonce

# Notification behaviour
Notification__DedupWindowMinutes=60
Notification__FrequencyCapPerDay=3
Notification__DefaultMaxAttempts=5
Notification__BulkMaxItems=500
Notification__WebhookSignatureToleranceSeconds=300

# Storage
ConnectionStrings__AppDb=Data Source=notifications.db;Cache=Shared
