{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OpenTelemetry": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=integration-hub.db"
  },
  "Secrets": {
    "FilePath": "data/secrets.enc",
    "MasterKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "Connectors": {
    "CrmBaseUrl": "http://localhost:5112",
    "ErpBaseUrl": "http://localhost:5212",
    "PaymentsBaseUrl": "http://localhost:5312",
    "AllowedHosts": [ "localhost" ],
    "AllowPrivateNetworks": true
  },
  "Retention": {
    "RunHistoryDays": 30
  },
  "Jwt": {
    "Issuer": "IntegrationHub.Local",
    "Audience": "IntegrationHub.Api",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789"
  },
  "ApiSecurity": {
    "DemoClientId": "demo-client",
    "DemoClientSecret": "dev-only-client-secret"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5012" ]
  }
}
