# ------------------------------------------------------------------------------
# Example Bank — Digital Banking Ledger — example environment configuration
# Copy to `.env` (gitignored) and adjust. NEVER commit real secrets.
# All values below are safe, non-secret local defaults.
# ------------------------------------------------------------------------------

# ASP.NET Core hosting
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5013

# ------------------------------------------------------------------------------
# Persistence adapter
#   Default provider is SQLite (zero external infrastructure). The schema and the
#   fictional "Example Bank" chart of accounts are created/seeded on startup.
#   A Postgres connection string can be supplied instead in a Postgres-enabled
#   build; SQLite remains the committed default (see ADR-005).
# ------------------------------------------------------------------------------
ConnectionStrings__Ledger=Data Source=ledger.db

# ------------------------------------------------------------------------------
# Authentication (JWT bearer, symmetric signing key)
#   The default SigningKey below is a well-known DEV-ONLY value and must be
#   overridden in any non-local environment via Auth__SigningKey.
#   EnableDevTokens exposes POST /api/v1/dev/token for local token minting and
#   MUST remain false outside Development/Testing.
# ------------------------------------------------------------------------------
Auth__Issuer=ExampleBank.Ledger
Auth__Audience=ExampleBank.Ledger.Api
Auth__SigningKey=dev-only-insecure-signing-key-please-override-me-01234567890
Auth__EnableDevTokens=true

# ------------------------------------------------------------------------------
# Logging (Serilog)
# ------------------------------------------------------------------------------
Serilog__MinimumLevel__Default=Information
