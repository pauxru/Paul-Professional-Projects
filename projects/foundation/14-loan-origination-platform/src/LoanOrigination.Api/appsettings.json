{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=loan-origination.db"
  },
  "ObjectStorage": {
    "Provider": "LocalFileSystem",
    "RootPath": "data\\objects"
  },
  "Kyc": {
    "Provider": "DeterministicSimulator",
    "ProductionAdapter": "Smile ID / Trulioo style adapter documented; no external call is made."
  },
  "Bureau": {
    "Provider": "DeterministicSimulator"
  },
  "Disbursement": {
    "Provider": "DeterministicSimulator"
  },
  "Jwt": {
    "Issuer": "rift-valley-credit-local",
    "Audience": "loan-origination-api",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789"
  },
  "Webhook": {
    "SigningSecret": "dev-only-webhook-secret-not-for-production-0123456789",
    "TimestampWindowMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5014" ]
  },
  "OpenTelemetry": {
    "Exporter": "Console"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
