# ==============================================================================
# FraudPipeline - Environment Configuration
# Copy to .env and fill in real values before running in a shared environment.
# NEVER commit .env to source control (see .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5015

# ------------------------------------------------------------------------------
# Database (EF Core, SQLite by default)
# ------------------------------------------------------------------------------
# The default is a file-based SQLite DB in the API project folder.
# For an in-memory dev DB use "DataSource=:memory:;Cache=Shared".
ConnectionStrings__Default=Data Source=fraud.db;Cache=Shared

# ------------------------------------------------------------------------------
# JWT signing
# ------------------------------------------------------------------------------
# In Development a dev key is auto-provisioned if this is not set.
# In Production this MUST be a 32+ byte random secret and MUST NOT be committed.
# Generate one with: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
Jwt__SigningKey=REPLACE_WITH_A_32_BYTE_BASE64_SECRET
Jwt__Issuer=fraud-pipeline-dev
Jwt__Audience=fraud-pipeline-clients
Jwt__AccessTokenMinutes=60

# ------------------------------------------------------------------------------
# Scoring configuration
# ------------------------------------------------------------------------------
# Hard latency budget in ms. Decisions that exceed this degrade to a conservative
# default and record a "budget_exceeded" reason. Default 50.
Scoring__LatencyBudgetMs=50

# Band thresholds. Below Approve -> Approve. Between Approve and StepUp -> StepUp.
# Between StepUp and Review -> Review. At or above Review -> Decline.
Scoring__ApproveMax=250
Scoring__StepUpMax=500
Scoring__ReviewMax=750

# Four-eyes required at or above this exposure amount for ConfirmedFraud
# case dispositions (USD-equivalent). Default 10000.
Cases__FourEyesExposureThreshold=10000

# ------------------------------------------------------------------------------
# Ingestion / streaming
# ------------------------------------------------------------------------------
# Number of channel partitions in PartitionedTransactionBus.
# Same-key events always land in the same partition (FNV-1a).
Ingestion__PartitionCount=8
# Per-partition bounded channel capacity (backpressure limit).
Ingestion__ChannelCapacity=1024

# ------------------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------------------
RateLimit__PermitsPerWindow=120
RateLimit__WindowSeconds=60

# ------------------------------------------------------------------------------
# Telemetry
# ------------------------------------------------------------------------------
# Set to an OTLP endpoint (e.g. http://localhost:4317) to export traces/metrics.
# Leave empty to disable OTLP export (console exporter still runs in Dev).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fraud-pipeline
