{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=fraudpipeline.db"
  },
  "Ingestion": {
    "PartitionCount": 8,
    "PerPartitionCapacity": 1024
  },
  "Scoring": {
    "LatencyBudgetMs": 50,
    "DegradedDecision": "Review",
    "EnableShadow": true
  },
  "CaseManagement": {
    "AlertThresholdScore": 500,
    "PrimaryLinkageEntity": "Card"
  },
  "Jwt": {
    "Issuer": "fraud-pipeline",
    "Audience": "fraud-pipeline",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789",
    "LifetimeMinutes": 60
  },
  "RateLimit": {
    "RequestsPerMinute": 300,
    "BurstSize": 60
  }
}
