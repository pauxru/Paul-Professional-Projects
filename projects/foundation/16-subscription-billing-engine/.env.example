# Development-only placeholders. Never use these values in production.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5016
Database__Provider=Sqlite
Database__ConnectionString=Data Source=billing.db
Jwt__Issuer=subscription-billing-local
Jwt__Audience=subscription-billing-api
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
Billing__ClosedPeriodUsageBehavior=Reject
Billing__TaxRoundingLevel=Line
Billing__UsTaxRate=0.0825
Billing__DunningRetryDays__0=1
Billing__DunningRetryDays__1=3
Billing__DunningRetryDays__2=5
Billing__DunningRetryDays__3=7
Billing__WebhookSigningSecret=dev-only-not-a-real-secret-webhook-key-0123456789
Billing__OutboundWebhookEndpoints__0=https://webhook-receiver.example.invalid/billing
Cors__AllowedOrigins__0=http://localhost:3016
