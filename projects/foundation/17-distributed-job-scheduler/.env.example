# .env.example — copy to .env and adjust. Only this example file is committed.
# ASP.NET Core binds nested config keys with a double underscore (Section__Key).

# ---- Hosting ----
ASPNETCORE_ENVIRONMENT=Development
# The API listens on http://localhost:5017 (see appsettings.json / launchSettings.json)
ASPNETCORE_URLS=http://localhost:5017

# ---- Database (SQLite by default; zero external infrastructure) ----
# Point every node at the SAME database file/connection so they coordinate through it.
Database__ConnectionString=Data Source=jobscheduler.db;Cache=Shared

# ---- JWT (DEV ONLY) ----
# This default key is a NON-SECRET placeholder. The app refuses to start in Production with it.
# Override with a real, high-entropy secret from your secret manager in any real deployment.
Jwt__Issuer=jobscheduler
Jwt__Audience=jobscheduler-api
Jwt__SigningKey=insecure-development-signing-key-change-me-0123456789abcdef
Jwt__AccessTokenMinutes=60

# ---- Node identity & role ----
# The API host can run an in-process worker/leader; standalone workers set these via --node-id/--tags.
Node__NodeId=api-embedded
Node__RunWorker=true
Node__RunLeader=true
Node__MaxConcurrency=4
# Node__Tags__0=etl
# Node__Tags__1=reports

# ---- Engine tuning (seconds unless noted) ----
Engine__LeaseSeconds=30
Engine__HeartbeatSeconds=10
Engine__PollSeconds=2
Engine__LeaderTtlSeconds=15
Engine__LeaderLoopSeconds=5
Engine__NodeTtlSeconds=45
Engine__GlobalMaxConcurrency=64
Engine__PriorityAgingPerMinute=1.0
Engine__RetentionMinutes=1440
Engine__CircuitFailureThreshold=5
Engine__CircuitCooldownSeconds=60

# ---- Seeding & telemetry ----
Seed__DemoData=true
OpenTelemetry__ConsoleExporter=false
