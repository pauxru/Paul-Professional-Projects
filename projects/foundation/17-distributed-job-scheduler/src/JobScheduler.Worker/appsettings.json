{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "Data Source=jobscheduler.db;Cache=Shared"
  },
  "Node": {
    "NodeId": "worker",
    "Tags": [],
    "MaxConcurrency": 4,
    "RunWorker": true,
    "RunLeader": true
  },
  "Engine": {
    "LeaseSeconds": 30,
    "HeartbeatSeconds": 10,
    "PollSeconds": 2,
    "LeaderTtlSeconds": 15,
    "LeaderLoopSeconds": 5,
    "NodeTtlSeconds": 45,
    "GlobalMaxConcurrency": 64,
    "PriorityAgingPerMinute": 1.0,
    "RetentionMinutes": 1440,
    "CircuitFailureThreshold": 5,
    "CircuitCooldownSeconds": 60,
    "QueueSlots": {}
  }
}
