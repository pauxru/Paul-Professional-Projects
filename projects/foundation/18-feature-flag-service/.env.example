# Feature Flag Service demo configuration. Copy to .env only for local overrides.
ASPNETCORE_ENVIRONMENT=Development
Database__Provider=Sqlite
Database__ConnectionString=Data Source=featureflags.db
Jwt__Issuer=FeatureFlags
Jwt__Audience=FeatureFlags.Api
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
FeatureFlags__ApiBaseUrl=http://localhost:5018
FeatureFlags__ProjectKey=acme
FeatureFlags__EnvironmentKey=dev
FeatureFlags__SdkKey=client-dev-acme-public-demo
