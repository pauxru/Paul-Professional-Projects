# --- AuditPlatform environment (all values here are placeholders) ---

# Database provider: Sqlite (default, no external infra required) or Postgres.
Database__Provider=Sqlite
Database__ConnectionString=Data Source=audit.db;Cache=Shared

# JWT signing — replace SigningKey with a 32+ character random value in every non-dev environment.
Jwt__Issuer=audit-platform
Jwt__Audience=audit-clients
Jwt__SigningKey=dev-only-signing-key-replace-me-in-any-real-environment

# Checkpoint signing key — RSA 2048 is generated in-process at boot for the dev build.
Signing__KeyId=local-dev-key-1

# Seed data — enables the deterministic Example Bank tenant. Development only.
Seed__Enabled=true
Seed__TenantId=example-bank
Seed__TenantDisplayName=Example Bank
