{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=secrets.db"
  },
  "Jwt": {
    "Issuer": "northstar-secrets-local",
    "Audience": "northstar-secrets-api",
    "SigningKey": "demo-only-not-a-real-secret-jwt-signing-key-change-me-0123456789"
  },
  "Crypto": {
    "KeyVersion": "local-v1",
    "MasterKey": "demo-only-not-a-real-secret-master-key-v1"
  },
  "Rotation": {
    "AcknowledgementTimeoutMinutes": 15,
    "SchedulerIntervalSeconds": 60
  },
  "Notifications": {
    "WebhookSigningKey": "demo-only-not-a-real-secret-webhook-signing-key",
    "MaxAttempts": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
