# Collab — example environment configuration.
# Copy to `.env` (gitignored) and adjust. These map to appsettings sections via ASP.NET config.
# NEVER put real secrets in this file — it is committed. Only `.env` (ignored) holds real values.

# --- Kestrel ---------------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
# API listens on http://localhost:5021 (project 21). No HTTPS on the local demo host.
ASPNETCORE_URLS=http://localhost:5021

# --- Database (SQLite by default; the same model runs on Postgres by swapping these) ---------------
ConnectionStrings__Default=Data Source=collab.db
# Postgres example (UNVERIFIED on this host — no Postgres available):
# ConnectionStrings__Default=Host=localhost;Database=collab;Username=collab;Password=change-me

# --- JWT (demo-grade; symmetric dev key). Refuse to run in Production with the default key. ---------
Jwt__Key=dev-only-signing-key-change-me-in-production-1234567890
Jwt__Issuer=collab
Jwt__Audience=collab-clients
Jwt__LifetimeHours=8

# --- Demo seed (idempotent). Set to false to start empty. -----------------------------------------
Seed__Demo=true

# --- Collaboration engine / abuse controls --------------------------------------------------------
Collaboration__MaxDocumentLength=200000
Collaboration__MaxOperationsPerSubmit=2000
Collaboration__SnapshotEveryNOperations=200
Collaboration__PresenceThrottleMs=150
Collaboration__PresenceIdleSeconds=20
Collaboration__PresenceEvictSeconds=60
Collaboration__OperationsPerSecondPerConnection=50
Collaboration__OperationBurst=200
Collaboration__MaxViolationsBeforeDisconnect=20

# --- Scale-out backplane (UNVERIFIED — see docs/decisions/ADR-005-scale-out-backplane.md) ----------
# Backplane__Provider=Redis
# Backplane__Redis=localhost:6379
