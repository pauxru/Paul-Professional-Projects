# Development-only example values. Do not use these in production.
ASPNETCORE_ENVIRONMENT=Development
Database__Provider=Sqlite
Database__ConnectionString=Data Source=enterprise-search.db
Jwt__Issuer=enterprise-search
Jwt__Audience=enterprise-search-clients
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
Search__QueryTimeoutMilliseconds=750
OpenTelemetry__ConsoleExporter=false
Cors__AllowedOrigins__0=http://localhost:3022
