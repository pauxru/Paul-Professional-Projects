{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=enterprise-search.db"
  },
  "Jwt": {
    "Issuer": "enterprise-search",
    "Audience": "enterprise-search-clients",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789",
    "LifetimeMinutes": 60
  },
  "Search": {
    "MaxPageSize": 50,
    "MaxFrom": 1000,
    "MaxClauses": 32,
    "MaxWildcardExpansion": 50,
    "MaxFuzzyCandidates": 2000,
    "QueryTimeoutMilliseconds": 750
  },
  "Bm25": { "K1": 1.2, "B": 0.75 },
  "FunctionScore": {
    "RecencyHalfLifeDays": 90,
    "RecencyWeight": 0.15,
    "PopularityWeight": 0.05,
    "InStockMultiplier": 1.1,
    "ClickWeight": 0.2
  },
  "OpenTelemetry": { "ConsoleExporter": false },
  "Cors": { "AllowedOrigins": [ "http://localhost:3022" ] },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
