# .env.example — copy to .env for local development.
# All values here are placeholders for a fictional demo; regenerate before any real use.

# API
ASPNETCORE_URLS=https://localhost:5023
ASPNETCORE_ENVIRONMENT=Development

# Database — SQLite by default (a file next to the API). Postgres example commented out.
ConnectionStrings__Default=Data Source=healthcare.db
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=healthcare;Username=postgres;Password=postgres

# Auth — Fictional dev signing key. NEVER reuse this in production.
Auth__Issuer=healthcare-dev
Auth__Audience=healthcare-clients
Auth__SigningKey=CHANGE-ME-A-32-CHAR-SECRET-9e7a17b0d4324a5c

# Feature toggles
Reminder__Sms__Enabled=true
Reminder__Email__Enabled=true

# Rate limiter
RateLimit__PerUserPerMinute=200
