# Development-only examples. Do not use these values in production.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5024
Database__Provider=Sqlite
Database__ConnectionString=Data Source=northstar-iga.db
Jwt__Issuer=northstar-iga-local
Jwt__Audience=northstar-iga-api
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
Jwt__TokenMinutes=60
Lifecycle__MoverGracePeriodDays=7
Lifecycle__StepMaxAttempts=3
Governance__ApprovalSlaHours=24
Governance__EscalatedApprovalSlaHours=8
Provisioning__MaxAttempts=3
Provisioning__RetryDelayMilliseconds=50
Cors__AllowedOrigins__0=http://localhost:5024
