{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=northstar-iga.db"
  },
  "Jwt": {
    "Issuer": "northstar-iga-local",
    "Audience": "northstar-iga-api",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789",
    "TokenMinutes": 60
  },
  "Lifecycle": {
    "MoverGracePeriodDays": 7,
    "StepMaxAttempts": 3
  },
  "Governance": {
    "ApprovalSlaHours": 24,
    "EscalatedApprovalSlaHours": 8,
    "DormantAccountDays": 90
  },
  "Provisioning": {
    "MaxAttempts": 3,
    "RetryDelayMilliseconds": 50
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5024"
    ]
  },
  "Telemetry": {
    "Exporter": "Console"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
