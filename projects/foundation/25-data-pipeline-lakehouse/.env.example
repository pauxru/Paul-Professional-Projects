# Data Pipeline & Analytics Lakehouse — example environment configuration.
# Copy to `.env` for local use. `.env` is gitignored; only this example is committed.
# All values here are safe placeholders — NO real secrets, NO personal data.
#
# The app binds config via the `Lakehouse:` section of appsettings.json. Any value can be overridden
# with a double-underscore environment variable, e.g. Lakehouse__Generator__Orders=5000.

# ---- host ----
ASPNETCORE_ENVIRONMENT=Development
# API listens here (see appsettings "Urls"). Port 5025 is the project default.
ASPNETCORE_URLS=http://localhost:5025

# ---- lake / serving storage (local filesystem; created on first run) ----
Lakehouse__LakeRoot=_data/lake
Lakehouse__ServingDbPath=_data/serving/serving.db
Lakehouse__SeedOnStartup=true

# ---- synthetic source generator (fictional Contoso Retail data) ----
Lakehouse__Generator__Seed=42
Lakehouse__Generator__Customers=200
Lakehouse__Generator__Products=80
Lakehouse__Generator__Orders=3000
Lakehouse__Generator__Sessions=2000
Lakehouse__Generator__Days=90
Lakehouse__Generator__DefectRate=0.03
Lakehouse__Generator__LateArrivalRate=0.06

# ---- auth (DEV ONLY — HS256 dev token endpoint) ----
# Replace with a real identity provider (Entra ID / OAuth2) for anything beyond local dev.
# This key is a non-secret placeholder; generate your own >= 32 byte key for local use.
Lakehouse__Auth__Issuer=lakehouse
Lakehouse__Auth__Audience=lakehouse-clients
Lakehouse__Auth__SigningKey=dev-only-signing-key-change-me-please-32bytes!
