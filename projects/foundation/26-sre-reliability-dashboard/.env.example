# Development-only example values. Do not commit a real .env file.
Database__Provider=Sqlite
Database__ConnectionString=Data Source=northstar-reliability.db
Jwt__Issuer=northstar-reliability
Jwt__Audience=northstar-reliability-api
Jwt__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
ErrorBudgetPolicy__WarningRemainingPercent=50
ErrorBudgetPolicy__RiskyDeployFreezeRemainingPercent=25
MetricRetention__RawRetentionHours=48
MetricRetention__HourlyRetentionDays=90
