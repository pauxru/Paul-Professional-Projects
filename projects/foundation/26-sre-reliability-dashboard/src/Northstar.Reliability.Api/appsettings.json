{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=northstar-reliability.db"
  },
  "Messaging": {
    "Provider": "InMemory"
  },
  "Cache": {
    "Provider": "Memory"
  },
  "Telemetry": {
    "ConsoleExporter": true
  },
  "ErrorBudgetPolicy": {
    "WarningRemainingPercent": 50,
    "RiskyDeployFreezeRemainingPercent": 25
  },
  "MetricRetention": {
    "RawRetentionHours": 48,
    "HourlyRetentionDays": 90
  },
  "BurnRateAlerts": {
    "FastPageLongWindowMinutes": 60,
    "FastPageShortWindowMinutes": 5,
    "FastPageLongThreshold": 14.4,
    "FastPageShortThreshold": 6,
    "SlowPageLongWindowMinutes": 360,
    "SlowPageShortWindowMinutes": 30,
    "SlowPageLongThreshold": 6,
    "SlowPageShortThreshold": 3,
    "SustainedTicketLongWindowMinutes": 4320,
    "SustainedTicketShortWindowMinutes": 1440,
    "SustainedTicketLongThreshold": 1,
    "SustainedTicketShortThreshold": 3
  },
  "Jwt": {
    "Issuer": "northstar-reliability",
    "Audience": "northstar-reliability-api",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
