# --- LoadRunner CLI configuration -----------------------------------------
# Copy to `.env` (which is gitignored) and populate. The template engine
# substitutes {{env.NAME}} at request time so scenarios can reference these
# without committing secrets.

# Bearer token for scenarios that talk to a protected API.
LOADRUN_TOKEN=

# Base URL for the target API — used by demo/CI scripts, NOT read by loadrun itself.
LOADRUN_BASE=http://127.0.0.1:5027

# --- SampleApi configuration ---------------------------------------------
# Kestrel listen address for the sample API.
ASPNETCORE_URLS=http://127.0.0.1:5027

# Environment name (Development enables OpenAPI / Scalar; Production disables them).
ASPNETCORE_ENVIRONMENT=Production

# Optional — override the SQLite connection string. Default is a file in the cwd.
# ConnectionStrings__Catalog=Data Source=sampleapi.db;Cache=Shared;Pooling=True
