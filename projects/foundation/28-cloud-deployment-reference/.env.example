# Development-only example values. Copy to .env; never commit the real file.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5028
Database__Provider=Sqlite
Database__ConnectionString=Data Source=storefront.db
Cache__Provider=Memory
Messaging__Provider=InMemory
KeyVault__Enabled=false
Security__Issuer=contoso-storefront-local
Security__Audience=contoso-storefront-api
Security__SigningKey=dev-only-not-a-real-secret-change-me-0123456789
Features__NewPricingDarkLaunch=false
Observability__Exporter=None
# For OTLP: Observability__Exporter=Otlp
# Observability__OtlpEndpoint=http://localhost:4317
# For Azure Monitor, set this only through user-secrets/environment/Key Vault:
# Observability__ApplicationInsightsConnectionString=<set-outside-source-control>
