# ---------------------------------------------------------------------------
# AI Agent Workflow Orchestration Platform — example environment configuration
# Copy to `.env` (gitignored) and adjust. Nothing here is a real secret.
# Every value has a safe offline default; the platform runs fully offline with
# the deterministic mock model and no configuration at all.
# ---------------------------------------------------------------------------

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5029

# Database (EF Core). SQLite is the default and only required provider.
# The same schema also runs on Postgres if you wire Npgsql, but SQLite is default.
ConnectionStrings__AgentDb=Data Source=agentplatform.db

# JWT bearer auth (symmetric HS256 so it works offline).
# MUST be overridden in any real deployment. The app refuses the default key in Production.
Jwt__Issuer=agent-platform
Jwt__Audience=agent-platform-clients
Jwt__SigningKey=dev-only-insecure-signing-key-change-me-please-32b
# Local-only convenience endpoint that mints dev tokens. Disable outside Development.
Jwt__EnableDevTokenEndpoint=true

# Model provider. "mock" (default) is the DeterministicMockModel — no network, no keys.
# Switch to "openai" or "azure" to use the compiled adapters (never reached by default/tests).
Model__Provider=mock
Model__ApiKey=
Model__Endpoint=
Model__Deployment=

# SSRF allow-list for the http_get tool. Only these hosts may ever be contacted;
# private/loopback/link-local ranges are always blocked and redirects are disabled.
Security__HttpAllowList__0=example.com
Security__HttpAllowList__1=www.example.com
Security__HttpAllowList__2=api.example.com
