{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=cloud-cost-observability.db"
  },
  "CostData": {
    "Provider": "Synthetic",
    "AzureExportPath": "",
    "AwsCurPath": ""
  },
  "Messaging": { "Provider": "InMemory" },
  "Cache": { "Provider": "Memory" },
  "Ai": { "Provider": "Mock" },
  "Jwt": {
    "Issuer": "CloudCostObservability",
    "Audience": "CloudCostObservability.Api",
    "SigningKey": "dev-only-not-a-real-secret-change-me-0123456789"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5030" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
